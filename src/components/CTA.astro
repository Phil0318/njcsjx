---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].cta;
---

<section class="bg-steel-700">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-20 text-center">
    <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">{t.title}</h2>
    {t.subtitle && <p class="mx-auto mt-4 max-w-2xl text-lg text-steel-100">{t.subtitle}</p>}
    <a
      href={`/${lang}/contact`}
      class="mt-8 inline-block rounded-full bg-accent-500 px-8 py-3.5 font-semibold text-white shadow-lg transition-transform hover:scale-105"
    >
      {t.button}
    </a>
  </div>
</section>
