---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';

const lang = 'zh' as const;

const certs = [
  {
    title: 'ISO 9001:2015 质量管理体系认证',
    body: '集团子公司南京正升机械制造有限公司通过 ISO 9001:2015 质量管理体系认证（证书编号 02925Q3DR48R3S），覆盖齿轮加工与热处理全过程质量管控。',
    images: ['/certificates/iso-9001-1.jpg', '/certificates/iso-9001-2.jpg'],
  },
  {
    title: 'ABS 船级社热处理设施与工艺认可',
    body: '南京斗升金属热处理有限公司获得美国船级社（ABS）热处理设施与工艺认可（证书编号 HT-0579098），工艺覆盖调质、渗碳淬火等，适用海洋装备零件（爬升小齿轮、输出齿轮等），有效期至 2031 年 1 月。',
    images: [
      '/certificates/abs-ht-0579098-1.jpg',
      '/certificates/abs-ht-0579098-2.jpg',
      '/certificates/abs-ht-0579098-3.jpg',
    ],
  },
  {
    title: '无损检测人员资质证书',
    body: '探伤人员持证上岗，具备超声波、磁粉探伤等资质，保障锻件与齿部探伤结果的权威性与可靠性。',
    images: [
      '/certificates/ndt-cert-1.jpg',
      '/certificates/ndt-cert-2.jpg',
      '/certificates/ndt-cert-3.jpg',
      '/certificates/ndt-cert-4.jpg',
    ],
  },
];
---

<Base
  lang={lang}
  title="资质认证 — 南京长升机械工程有限公司"
  description="长升集团资质：ISO 9001:2015 质量管理体系认证（02925Q3DR48R3S）、ABS 船级社热处理设施认可（HT-0579098，有效期至 2031 年）、无损检测人员资质证书。"
>
  <section class="page-heading bg-ink">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-12 sm:pt-24 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent-400">资质认证</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">资质与认证。</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-300">
        ISO 9001 质量管理体系、ABS 船级社热处理设施认可与无损检测人员资质，
        为客户提供可信赖的质量保障。
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl space-y-16 px-4 sm:px-6">
      {certs.map((c) => (
        <div>
          <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">{c.title}</h2>
          <p class="mt-3 max-w-3xl leading-relaxed text-slate-600">{c.body}</p>
          <div class:list={['mt-6 grid gap-6', c.images.length > 1 && 'sm:grid-cols-2']}>
            {c.images.map((img) => (
              <a
                href={img}
                target="_blank"
                rel="noopener"
                class="overflow-hidden rounded-lg border border-slate-100 bg-white p-3 shadow-sm transition-shadow hover:shadow-lg"
              >
                <img
                  src={img}
                  alt={c.title}
                  loading="lazy"
                  class="mx-auto h-auto w-full rounded-xl object-contain ring-1 ring-slate-100"
                />
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <CTA lang={lang} />
</Base>
