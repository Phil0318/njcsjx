---
import Base from '../../../layouts/Base.astro';
import CTA from '../../../components/CTA.astro';
import EquipTable from '../../../components/EquipTable.astro';
import EquipTip from '../../../components/EquipTip.astro';
import MachineSection from '../../../components/MachineSection.astro';

const lang = 'zh' as const;

const featured = [
  {
    make: '美国格里森',
    model: '1000GMS 齿轮测量中心',
    spec: '最大检测直径 1000 mm × 高度 1200 mm',
    desc: '国际先进的齿轮测量设备，覆盖模数 1–56 的圆柱齿轮全参数检测。',
    img: '/equipment-photos/gleason-1000gms.jpg',
  },
  {
    make: '海克斯康',
    model: '15.22.10 三坐标测量仪',
    spec: '行程 1500 × 2200 × 1000',
    desc: '检测平行度、同轴度、圆度等形位公差及齿部精度。',
    img: '/equipment-photos/cmm-hexagon.jpg',
  },
  {
    make: '意大利 DEA',
    model: 'Delta20.33.15 三坐标测量仪',
    spec: '行程 3300 × 2000 × 1500',
    desc: '适合大型零件形位公差检测。',
    img: '/equipment-photos/cmm-dea.jpg',
  },
  {
    make: 'VENUS',
    model: '20.33.14 三坐标测量仪',
    spec: '行程 3300 × 2000 × 1400',
    desc: '大行程精密测量。',
    img: '/equipment-photos/cmm-venus.jpg',
  },
  {
    make: '德国蔡司',
    model: 'XJG-04 大型金相显微镜',
    spec: '常规、感应、化学、热处理后金相分析',
    desc: '用于金相组织判断与失效分析。',
    img: '/equipment-photos/zeiss-xjg04.jpg',
  },
];

const cmms = [
  { m: '三坐标测量仪 Hexagon 15.22.10', r: '1500 × 2200 × 1000', i: '海克斯康三坐标测量仪，检测平行度、同轴度、圆度等形位公差及齿部精度。' },
  { m: '三坐标测量仪 DEA Delta20.33.15', r: '3300 × 2000 × 1500', i: '意大利 DEA 三坐标测量仪，适合大型零件形位公差检测。' },
  { m: '三坐标测量仪 VENUS20.33.14', r: '3300 × 2000 × 1400', i: '上海灿栎 VENUS 三坐标测量仪，大行程精密测量。' },
];

const ndt = [
  '超声波探伤仪 OMNISX（奥林巴斯）/ USM36S（GE）',
  '磁粉探伤机 CJW-10000（齿面探伤）',
  '直读式光谱仪 DE-2000（检测 28 个合金元素）',
  '齿面烧伤检测线（酸洗检测）',
  '剩磁仪 HT20A / 粗糙度仪 三丰 178-560 ×4',
];

const hardnessMetallography = [
  '里氏硬度计 9 台 / 布氏硬度计 4 台 / 洛氏硬度计 4 台',
  '维氏硬度计 2 台 / 显微硬度计 HV-1000AT 2 台',
  '金相显微镜 4XC / XJX-1 / 德国蔡司 XJG-04 大型金相显微镜',
  '金相制样设备：镶嵌 XQ-1、切割 QG-5A、预磨 YM-2A、抛光 PG-2B',
];

const mechanicalTests = [
  '万能试验机 WDW-300（抗拉、屈服、延伸率）',
  '冲击试验机 JB-300B + 低温箱 DWY-60A',
  '缺口拉床 L71-UV / 缺口投影仪 XD-50 / 标距仪 DX-400',
  '电子天平 FA1004B / 快速碳势测定仪 GM-1A',
  '箱式实验炉 RJJ-950 / RJS-300（工艺验证）',
];
---

<Base
  lang={lang}
  title="检测与计量 — 南京长升机械工程有限公司"
  description="长升检测设备：Gleason 1000GMS齿轮测量中心、海克斯康/DEA/VENUS三坐标、超声波与磁粉探伤、蔡司大型金相显微镜、硬度计与力学试验机。"
>
  <section class="bg-ink">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-12 sm:pt-24">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent-400">服务与设备 · 检测与计量</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">检测与计量</h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-300">
        从原材料到成品的全流程质量管控：齿轮测量、三坐标检测、无损探伤、
        硬度与金相分析、力学性能试验，为每一件产品出具可靠数据。
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-steel-600">设备展示</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ink sm:text-4xl">重点设备详解</h2>
      </div>
      <div class="mt-12 space-y-16">
        {featured.map((f) => (
          <MachineSection
            make={f.make}
            model={f.model}
            spec={f.spec}
            desc={f.desc}
            img={f.img}
            makeLabel="制造商"
            modelLabel="型号"
            specLabel="规格"
            details={[
              { src: f.img.replace(/(\.[a-z]+)$/, '-panel$1'), label: '测量界面' },
              { src: f.img.replace(/(\.[a-z]+)$/, '-detail$1'), label: '设备细节' },
            ]}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="bg-steel-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-steel-600">设备明细</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ink sm:text-4xl">全部检测设备清单</h2>
      </div>

      <div id="gleason" class="scroll-mt-24 mt-10 rounded-2xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
        <h3 class="font-display text-lg font-bold text-ink">Gleason 1000GMS 齿轮测量中心</h3>
        <p class="mt-2 text-sm text-slate-600">国际先进的齿轮测量设备，最大检测直径 1000 mm、最大检测高度 1200 mm。</p>
        <div class="mt-4 grid gap-2.5 text-sm text-slate-600 sm:grid-cols-2 lg:grid-cols-3">
          {[
            ['模数', '1 – 56'],
            ['螺旋角', '0 – 60°'],
            ['基圆直径', '20 – 1000 mm'],
            ['最大齿顶圆直径', '1000 mm'],
            ['齿宽', '800 mm'],
            ['中心距', '170 – 750 mm'],
            ['最大工件重量', '5000 kg'],
          ].map(([k, v]) => (
            <div class="rounded-xl bg-steel-50 px-4 py-3">
              <span class="text-slate-500">{k}：</span>
              <span class="font-semibold text-ink">{v}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-6">
        <EquipTable
          id="cmm"
          title="三坐标测量仪"
          note="检测范围：平行度、同轴度、圆度等形位公差；齿部 Fp、Fr、Fα、Fβ 等精度指标。"
          head={['仪器', '行程范围（X × Y × Z）']}
          rows={cmms}
        />
      </div>

      <div id="ndt" class="scroll-mt-24 mt-6 rounded-2xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
        <h3 class="font-display text-lg font-bold text-ink">无损探伤与材质分析</h3>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {ndt.map((i) => (
            <div class="flex items-center gap-3 rounded-2xl bg-steel-50 p-4 text-sm font-medium text-ink">
              <span class="h-2 w-2 shrink-0 rounded-full bg-accent-500"></span>
              {i}
            </div>
          ))}
        </div>
      </div>

      <div id="labs" class="scroll-mt-24 mt-6 grid gap-3 md:grid-cols-2">
        <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
          <h3 class="font-display text-lg font-bold text-ink">硬度与金相</h3>
          <ul class="mt-4 grid gap-2.5 text-sm text-slate-600">
            {hardnessMetallography.map((i) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500"></span>
                {i}
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
          <h3 class="font-display text-lg font-bold text-ink">力学性能与工艺试验</h3>
          <ul class="mt-4 grid gap-2.5 text-sm text-slate-600">
            {mechanicalTests.map((i) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500"></span>
                {i}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <EquipTip placeholder="设备照片待补充" />
  <CTA lang={lang} />
</Base>
