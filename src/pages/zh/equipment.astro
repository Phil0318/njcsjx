---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';

const lang = 'zh' as const;

const divisions = [
  {
    href: `/${lang}/equipment/machining`,
    num: '01',
    title: '机械加工设备',
    blurb: '德国 NILES 磨齿机群、韩国斗山车床、数控立车与滚铣插齿机床，覆盖齿轮全序加工。',
    stats: [['磨齿能力', 'M50 × Φ3000'], ['机加设备', '50+ 台套'], ['铣齿能力', 'M50 × Φ5000']],
  },
  {
    href: `/${lang}/equipment/heat-treatment`,
    num: '02',
    title: '热处理设备与工艺',
    blurb: '爱协林/天龙大型井式渗碳炉、真空高压气淬炉、多用炉与深冷炉，年产能约 5 万吨。',
    stats: [['最大渗碳炉', 'Φ4000 × 2000'], ['单件能力', '0.1 kg – 30 t'], ['资质', 'ABS 认可']],
  },
  {
    href: `/${lang}/equipment/inspection`,
    num: '03',
    title: '检测与计量',
    blurb: 'Gleason 齿轮测量中心、三坐标、无损探伤与理化实验室，全流程质量管控。',
    stats: [['齿轮测量', 'Gleason 1000GMS'], ['三坐标', '3 台（最大行程 3.3 m）'], ['金相分析', '蔡司 XJG-04']],
  },
];
---

<Base
  lang={lang}
  title="服务与设备 — 南京长升机械工程有限公司"
  description="长升集团三大业务板块：机械加工（NILES磨齿机M50×Φ3000）、热处理（爱协林/天龙井式渗碳炉、ABS认可）、检测与计量（Gleason齿轮测量中心、三坐标）。"
>
  <section class="page-heading bg-ink">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-14 sm:pt-24 sm:pb-20 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent-400">服务与设备</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">三大服务板块，一条完整产业链。</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-300">
        从毛坯到成品齿轮——机械加工、热处理、检测与计量环环相扣，
        50 余台套机加设备、100 余台套热处理设备与专业计量实验室保障产品质量。
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid gap-6 lg:grid-cols-3">
        {divisions.map((d) => (
          <a
            href={d.href}
            class="group flex flex-col rounded-lg border border-slate-100 bg-white p-8 shadow-sm transition-shadow hover:shadow-md"
          >
            <div class="flex items-center justify-between">
              <span class="font-display text-4xl font-bold text-steel-200 transition-colors group-hover:text-accent-500">
                {d.num}
              </span>
              <svg
                class="h-6 w-6 text-steel-300 transition-transform group-hover:translate-x-1 group-hover:text-accent-500"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12l-7.5 7.5M21 12H3"></path>
              </svg>
            </div>
            <h2 class="mt-6 font-display text-2xl font-bold text-ink">{d.title}</h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{d.blurb}</p>
            <dl class="mt-6 space-y-2.5 border-t border-slate-100 pt-5">
              {d.stats.map(([k, v]) => (
                <div class="flex items-baseline justify-between gap-3 text-sm">
                  <dt class="text-slate-500">{k}</dt>
                  <dd class="font-semibold text-ink">{v}</dd>
                </div>
              ))}
            </dl>
          </a>
        ))}
      </div>

      <div class="mt-12 rounded-lg bg-ink p-8 sm:p-10">
        <div class="grid gap-6 sm:grid-cols-3">
          {[
            ['NILES 磨齿机 6 台', '最大模数 50 × 直径 3000 毫米'],
            ['ABS 船级社认可', '海洋装备热处理设施与工艺'],
            ['Gleason 齿轮测量', '模数 1–56 全参数检测'],
          ].map(([title, desc]) => (
            <div>
              <p class="font-display text-lg font-bold text-white">{title}</p>
              <p class="mt-1.5 text-sm text-slate-400">{desc}</p>
            </div>
          ))}
        </div>
        <a
          href={`/${lang}/products`}
          class="mt-8 inline-block rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-accent-400 hover:text-accent-400"
        >
          查看产品展示 →
        </a>
      </div>
    </div>
  </section>

  <CTA lang={lang} />
</Base>
