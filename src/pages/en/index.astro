---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import EquipPhoto from '../../components/EquipPhoto.astro';

const lang = 'en' as const;

const capabilities = [
  {
    title: 'Full-process gear machining',
    body: 'Turning, hobbing, milling, shaping, heat treatment, shot peening, gear grinding, internal grinding, and chamfering — all in one plant, with gear grinding up to module 50 × Ø3000 mm.',
    points: ['6 NILES gear grinders (ZE400S–ZP30)', 'CNC vertical lathes up to Ø2500 mm', '3/4-axis machining centers, wire EDM'],
  },
  {
    title: 'Metal heat treatment',
    body: 'Normalizing, annealing, quenching & tempering, carburizing, carbonitriding, nitriding, nitrocarburizing, vacuum oil quenching, high-pressure gas quenching, induction hardening, shot peening, and blackening for ferrous, non-ferrous, and special materials.',
    points: ['Single parts from 0.1 kg to 30 t', 'Annual capacity ~50,000 t', 'Large pit carburizing furnaces up to Φ4000 × 2500'],
  },
  {
    title: 'Inspection & metrology',
    body: 'Full quality control from raw material to finished part: gear measurement, CMM inspection, NDT, hardness & metallographic analysis, and mechanical testing.',
    points: ['Gleason 1000GMS gear analyzer', 'Three CMMs (Hexagon / DEA / VENUS)', 'Ultrasonic & magnetic particle NDT, spectrometry'],
  },
];

const industries = [
  { label: 'Offshore drilling', img: '/industries/offshore.png' },
  { label: 'Wind power', img: '/industries/wind.png' },
  { label: 'Petrochemical', img: '/industries/petrochemical.png' },
  { label: 'Coal mining', img: '/industries/coal.png' },
  { label: 'Metallurgy', img: '/industries/metallurgy.png' },
  { label: 'Building materials', img: '/industries/building-materials.png' },
];
---

<Base
  lang={lang}
  title="Nanjing Changsheng Machinery Engineering Co., Ltd. — Gears & Heat Treatment"
  description="Nanjing Changsheng Machinery Engineering Co., Ltd. (est. 2006) specializes in full-process gear machining and metal heat treatment — gear grinding up to module 50 × Ø3000 mm, ~50,000 t annual heat-treatment capacity."
>
  <section class="home-hero">
    <div class="hero-layout">
      <div class="hero-copy">
        <p class="eyebrow">CHANGSHENG · SINCE 2006</p>
        <h1>Precision gears.<br /><span>Expert heat treatment.</span></h1>
        <p class="hero-intro">Integrated machining, gear cutting, heat treatment and inspection for critical industrial components.</p>
        <div class="hero-actions">
          <a class="primary-action" href="/en/contact">Request a quote →</a>
          <a class="secondary-action" href="#capabilities">Explore capabilities ↓</a>
        </div>
      </div>
      <figure class="hero-photo">
        <img src="/equipment-photos/niles-ze1200.jpg" alt="NILES ZE1200 gear grinding equipment" width="1200" height="900" fetchpriority="high" />
        <figcaption><span>Precision gear grinding</span><span>NILES ZE1200</span></figcaption>
      </figure>
    </div>
    <div class="hero-facts">
      {[['2006', 'Established'], ['50+', 'Machine tools'], ['45,000', 'm² of factory space'], ['50,000', 't annual heat treatment capacity']].map(([value, label]) => (
        <div><strong>{value}</strong><span>{label}</span></div>
      ))}
    </div>
  </section>

  <!-- Capabilities -->
  <section id="capabilities" class="services-section py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-steel-600">Services</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ink sm:text-4xl">Three services, one complete gear-part process.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          capabilities.map((c) => (
            <div class="rounded-lg border border-slate-100 bg-white p-8 shadow-sm">
              <h3 class="font-display text-xl font-bold text-ink">{c.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{c.body}</p>
              <ul class="mt-5 space-y-2.5 text-sm text-slate-500">
                {c.points.map((p) => (
                  <li class="flex items-start gap-2">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {p}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured equipment -->
  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-wider text-steel-600">Equipment</p>
          <h2 class="mt-3 font-display text-3xl font-bold text-ink sm:text-4xl">Equipment and capabilities.</h2>
        </div>
        <a href={`/${lang}/equipment`} class="text-sm font-semibold text-accent-500 transition-colors hover:text-accent-600">
          View all equipment →
        </a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <a
          href={`/${lang}/equipment/machining`}
          class="group rounded-lg border border-slate-100 bg-white p-4 shadow-sm transition-shadow hover:shadow-lg"
        >
          <EquipPhoto src="/equipment-photos/niles-zp30.jpg" name="NILES ZP30" class="aspect-[4/3]" fit="contain" />
          <p class="mt-4 font-display text-lg font-bold text-ink">NILES ZP30 gear grinder</p>
          <p class="mt-1 text-sm text-accent-500">M50 × Φ3000 (external)</p>
        </a>
        <a
          href={`/${lang}/equipment/machining`}
          class="group rounded-lg border border-slate-100 bg-white p-4 shadow-sm transition-shadow hover:shadow-lg"
        >
          <EquipPhoto src="/equipment-photos/puma-480l.jpg" name="DOOSAN PUMA 480L" class="aspect-[4/3]" fit="contain" />
          <p class="mt-4 font-display text-lg font-bold text-ink">DOOSAN PUMA 480L CNC lathe</p>
          <p class="mt-1 text-sm text-accent-500">Shafts and rotational components</p>
        </a>
        <a
          href={`/${lang}/equipment/machining`}
          class="group rounded-lg border border-slate-100 bg-white p-4 shadow-sm transition-shadow hover:shadow-lg"
        >
          <EquipPhoto src="/equipment-photos/hcmc-1370.jpg" name="HCMC-1370" class="aspect-[4/3]" fit="contain" />
          <p class="mt-4 font-display text-lg font-bold text-ink">HCMC-1370 machining center</p>
          <p class="mt-1 text-sm text-accent-500">Milling, drilling and multi-operation machining</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="bg-steel-50 py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-steel-600">Industries served</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ink sm:text-4xl">Two decades in heavy-industry critical parts.</h2>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {industries.map((i) => (
          <div class="group overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-slate-100">
            <div class="overflow-hidden bg-steel-100">
              <img
                src={i.img}
                alt={i.label}
                loading="lazy"
                width="304"
                height="228"
                class="h-32 w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
            <p class="px-5 py-3.5 font-semibold text-ink">{i.label}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 rounded-lg bg-ink p-8 sm:p-10">
        <div class="grid gap-6 sm:grid-cols-3">
          {[
            ['Mud-pump gears & shafts', 'Core drive parts for offshore drilling rigs'],
            ['Wind pitch gear shafts', 'Key components for wind turbines'],
            ['Electric-wheel double gears', 'Drive systems for mining vehicles'],
          ].map(([title, desc]) => (
            <div>
              <p class="font-display text-lg font-bold text-white">{title}</p>
              <p class="mt-1.5 text-sm text-slate-400">{desc}</p>
            </div>
          ))}
        </div>
        <a href={`/${lang}/products`} class="mt-8 inline-block rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-accent-400 hover:text-accent-400">
          View products →
        </a>
      </div>
    </div>
  </section>

  <!-- Culture -->
  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-steel-600">Company culture</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ink sm:text-4xl">Rigorous · Efficient · Pragmatic · Innovative</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          <span class="font-semibold text-ink">Teamwork, customer first, goal driven.</span>
          Sharing success with customers, development with employees, and progress with society —
          to be the professional gear and heat-treatment supplier.
        </p>
        <a href={`/${lang}/about`} class="mt-8 inline-block rounded-full bg-steel-700 px-7 py-3 font-semibold text-white transition-colors hover:bg-steel-800">
          About Changsheng →
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          ['58', 'engineers & technicians'],
          ['126', 'skilled workers'],
          ['100', 'mu site area'],
          ['50+', 'machining equipment'],
        ].map(([num, label]) => (
          <div class="rounded-lg border border-slate-100 bg-white p-7 text-center shadow-sm">
            <p class="font-display text-3xl font-bold text-steel-600">{num}</p>
            <p class="mt-2 text-sm text-slate-600">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality assurance -->
  <section class="bg-steel-50 py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-wider text-steel-600">Quality assurance</p>
          <h2 class="mt-3 font-display text-3xl font-bold text-ink sm:text-4xl">Certifications & inspection capability.</h2>
        </div>
        <a href={`/${lang}/certificates`} class="text-sm font-semibold text-accent-500 transition-colors hover:text-accent-600">
          View certificates →
        </a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-lg border border-slate-100 bg-white p-8 shadow-sm">
          <p class="font-display text-2xl font-bold text-accent-500">ISO 9001</p>
          <p class="mt-2 font-display font-bold text-ink">Quality management system</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">ISO 9001:2015 (cert. no. 02925Q3DR48R3S) covering gear machining and heat treatment.</p>
        </div>
        <div class="rounded-lg border border-slate-100 bg-white p-8 shadow-sm">
          <p class="font-display text-2xl font-bold text-accent-500">ABS</p>
          <p class="mt-2 font-display font-bold text-ink">Heat-treatment facility approval</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">ABS approval HT-0579098 for marine components, valid until 2031.</p>
        </div>
        <div class="rounded-lg border border-slate-100 bg-white p-8 shadow-sm">
          <p class="font-display text-2xl font-bold text-accent-500">NDT</p>
          <p class="mt-2 font-display font-bold text-ink">Certified NDT inspectors</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Qualified ultrasonic & magnetic particle inspectors for forgings and tooth flanks.</p>
        </div>
      </div>
    </div>
  </section>

  <CTA lang={lang} />
</Base>
