---
import Base from '../../../layouts/Base.astro';
import CTA from '../../../components/CTA.astro';
import EquipTable from '../../../components/EquipTable.astro';
import EquipPhoto from '../../../components/EquipPhoto.astro';
import EquipTip from '../../../components/EquipTip.astro';

const lang = 'en' as const;

const categories = [
  {
    id: 'gear-grinding',
    title: 'Gear Grinding',
    note: 'German NILES / Hoffmann profile grinders, up to module 50 × Ø3000 mm (external).',
    photos: [
      {
        img: '/equipment-photos/niles-zp30.jpg',
        model: 'NILES ZP30',
        spec: 'M50 × Ø3000 (external) / Ø2500 (internal)',
        desc: 'Our largest grinder — for ultra-large offshore drilling gears.',
      },
      {
        img: '/equipment-photos/niles-ze400s.jpg',
        model: 'NILES ZE400S',
        spec: 'M18 × Ø400',
        desc: 'Precision profile grinder — high tooth accuracy, low noise.',
      },
    ],
    rows: [
      { m: 'NILES ZE400S', r: 'M18 × Ø400', i: 'German NILES precision profile grinder for small-to-medium module gears — high accuracy, low noise.' },
      { m: 'NILES ZE800', r: 'M32 × Ø800', i: 'German NILES profile grinder for efficient finishing of medium and large cylindrical gears.' },
      { m: 'NILES ZE1200', r: 'M40 × Ø1200 (ext.) / M12 × Ø1100 (int.)', i: 'German NILES internal/external profile grinder for batch finishing up to Ø1200 mm.' },
      { m: 'NILES ZP20', r: 'M50 × Ø2000 (ext.) / Ø1480 (int.)', i: 'Large gear grinding up to Ø2000 mm — widely used for wind and mining gears.' },
      { m: 'NILES ZP30', r: 'M50 × Ø3000 (ext.) / Ø2500 (int.)', i: 'Our largest grinder — Ø3000 mm external — for ultra-large offshore drilling gears.' },
      { m: 'Ri1250 (German Hoffmann)', r: 'M25 × Ø1200 (ext.)', i: 'High-efficiency profile grinder for heavy-duty gears.' },
    ],
  },
  {
    id: 'turning',
    title: 'CNC Turning',
    note: 'Horizontal and vertical CNC lathes, complemented by conventional engine lathes.',
    photos: [
      {
        img: '/equipment-photos/puma-480l.jpg',
        model: 'DOOSAN PUMA 480L',
        spec: 'Ø900 × 2042',
        desc: 'Doosan high-rigidity CNC lathe for heavy cutting.',
      },
      {
        img: '/equipment-photos/vl-160c.jpg',
        model: 'HONOR VL-160C CNC vertical lathe',
        spec: 'Ø2000 × 1250',
        desc: 'Honor CNC vertical lathe for efficient turning of large rotational parts.',
      },
    ],
    rows: [
      { m: 'CNC lathe DOOSAN PUMA 480L', r: 'Ø900 × 2042', i: 'Doosan high-rigidity horizontal lathe for heavy cutting.' },
      { m: 'CNC lathe CKBP6180/2', r: 'Ø800 × 2000', i: 'Anyang Xinsheng CNC horizontal lathe for medium and large shafts.' },
      { m: 'CNC lathe CK61125E/3', r: 'Ø1250 × 3000', i: 'Anyang Xinsheng heavy-duty horizontal lathe for long shafts.' },
      { m: 'CNC vertical lathe HONOR VL-160C', r: 'Ø2000 × 1250', i: 'Honor CNC vertical lathe for efficient turning of large rotational parts.' },
      { m: 'CNC vertical lathe SZ1600ATC', r: 'Table Ø1600, swing Ø2000 × 1250', i: 'Suzhou Sanzhong CNC vertical lathe with tool magazine for automated turning.' },
      { m: 'CNC vertical lathe C5225×16/10', r: 'Table Ø2000, swing Ø2500 × 1600', i: 'Qiqihar double-column vertical lathe, up to Ø2500 mm.' },
      { m: 'Engine lathes CA6266C / CW6180B / CW61125', r: 'Ø660–1250 × 3000', i: 'Five Shenyang and other engine lathes for roughing and auxiliary operations.' },
    ],
  },
  {
    id: 'gear-cutting',
    title: 'Gear Cutting Machines',
    note: 'Hobbing, milling, shaping, chamfering and hob sharpening — up to module 50 × Ø5000 mm.',
    photos: [
      {
        img: '/equipment-photos/ykhl51160.jpg',
        model: 'YKHL51160 CNC gear shaper',
        spec: 'M20 × Ø1600 (ext.) / Ø2000 (int.)',
        desc: 'Wuhan Gewei CNC shaper for large internal and blind-hole gears.',
      },
      {
        img: '/equipment-photos/y31125.jpg',
        model: 'Y31125 gear hobber',
        spec: 'M18 × Ø1250',
        desc: 'Chongqing hobber for medium and large cylindrical gears.',
      },
    ],
    rows: [
      { m: 'CNC gear miller YK31500L', r: 'M50 × Ø5000', i: 'Qizhong CNC gear miller — module 50, Ø5000 mm — for form-milling of ultra-large gears.' },
      { m: 'CNC gear miller YK83200', r: 'M26/32 × Ø2500, 10 t load', i: 'Yichang Changji CNC miller with internal/external milling heads, 10 t table load.' },
      { m: 'CNC gear hobber Y31200CNC', r: 'M32 × Ø2500', i: 'Hebei Zhuohao CNC hobber for large-module cylindrical gears.' },
      { m: 'Gear hobbers Y3180H ×3', r: 'M10 × Ø800', i: 'Three Chongqing hobbers for small-to-medium module gears.' },
      { m: 'Gear hobbers YA31125 / Y31125E', r: 'M18 × Ø1250', i: 'Chongqing hobbers for medium and large cylindrical gears.' },
      { m: 'CNC gear shaper YKHL51160', r: 'M20 × Ø1600 (ext.) / Ø2000 (int.)', i: 'Wuhan Gewei CNC shaper for large internal and blind-hole gears.' },
      { m: 'Gear shaper YK5150B', r: 'M8 × Ø500 (ext.) / Ø625 (int.)', i: 'Nanjing Bocheng shaper for small-to-medium internal gears.' },
      { m: 'Chamfering machine YKDV150B', r: 'M32 × Ø1500', i: 'Shaanxi Guoxi chamfering machine for gear face and tooth-edge chamfering.' },
      { m: 'Hob sharpener M6425', r: 'Hobs Ø50–250', i: 'Wuhan hob sharpening machine keeping hobs at full accuracy.' },
    ],
  },
  {
    id: 'machining-centers',
    title: 'Machining Centers',
    note: '',
    photos: [
      {
        img: '/equipment-photos/vm1580.jpg',
        model: 'SK-VM1580 vertical machining center',
        spec: '1500 × 800 × 700',
        desc: 'Vertical machining center for general precision milling.',
      },
      {
        img: '/equipment-photos/hcmc-1370.jpg',
        model: 'HCMC-1370 4-axis machining center',
        spec: '1300 × 700 × 660',
        desc: 'Hartford 4-axis machining center for multi-face machining in one setup.',
      },
    ],
    rows: [
      { m: 'Gantry machining center SK-LMX2030', r: '2000 × 3000 × 1500', i: 'Large gantry machining center for big structural parts.' },
      { m: 'Machining center SK-VM1580', r: '1500 × 800 × 700', i: 'Vertical machining center for general precision milling.' },
      { m: 'Machining center HCMC-1370', r: '1300 × 700 × 660', i: 'Hartford 4-axis machining center for multi-face machining in one setup.' },
    ],
  },
  {
    id: 'grinding-machines',
    title: 'Precision Grinding',
    note: 'Internal, cylindrical, surface, and crankshaft grinding.',
    photos: [
      {
        img: '/equipment-photos/mg28100.jpg',
        model: 'MG28100 CNC vertical grinder',
        spec: 'Ø2000 × 800',
        desc: 'Wuxi Mingxin vertical CNC grinder for precision grinding of large disc and ring parts.',
      },
    ],
    rows: [
      { m: 'CNC vertical grinder MG28100', r: 'Ø2000 × 800', i: 'Wuxi Mingxin vertical CNC grinder for precision ID/OD grinding of large disc and ring parts.' },
      { m: 'Cylindrical grinder M1350B', r: 'Ø630 × 3000', i: 'Cylindrical grinder for precision OD finishing of shafts.' },
      { m: 'Crankshaft grinder MQ8260', r: 'Ø580 × 1600', i: 'Hanzhong crankshaft grinder for crankshaft-type parts.' },
      { m: 'Internal grinder M250A', r: 'Ø150–500 × 450', i: 'Wuxi internal grinder for precision bore grinding.' },
      { m: 'Surface grinder M7132H', r: 'Ø600 × 2000', i: 'Surface grinder for precision face grinding.' },
    ],
  },
];

const boringDrilling = [
  { m: 'Boring machine TK6110C/2', r: 'Spindle Ø110, max bore Ø2000', i: 'Horizontal boring machine for boring of large housing-type parts.' },
  { m: 'Boring machine TX6113C/2', r: 'Spindle Ø110, max bore Ø1300', i: 'Horizontal boring machine for large-part boring.' },
  { m: 'Radial drill Z3080×25I', r: 'Ø80 × 2500 arm', i: 'Radial drill for drilling and tapping on large parts.' },
  { m: 'Radial drill Z3050×16I', r: 'Ø50 × 1600 arm', i: 'Radial drill for drilling and tapping on medium parts.' },
  { m: 'Radial drill Z3132B', r: 'Ø32 × 1000 arm', i: 'Radial drill for small-to-medium parts.' },
];

const wireCutting = [
  { m: 'Wire-cut machine DK7763', r: 'Ø600 × 630', i: 'Wire EDM for complex profiles and precision dies.' },
];

const sawingRough = [
  'Band saws GW4028B / GB4250',
  'Roughing shop: lathes C6136A-D, CA6266C, C6140D, CW6180B, CW61125, CA6140A, C6150D, CK6280B, CK6140, C5116A',
  'Roughing shop: gantry mill SW-4200 (4000 × 2000 × 1350), universal mill X6140',
];
---

<Base
  lang={lang}
  title="Machining Equipment — Nanjing Changsheng Machinery Engineering Co., Ltd."
  description="Changsheng machining equipment: German NILES gear grinders up to module 50 × Ø3000 mm, Doosan PUMA 480L, CNC lathes, gear cutting machines and gantry machining centers — 50+ machine tools."
>
  <section class="page-heading bg-ink">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-16 sm:pt-24 sm:pb-20">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.13em] text-accent-400">Industrial Machining Capabilities</p>
          <h1 class="mt-6 max-w-xl font-display text-4xl font-bold leading-[1.1] tracking-tight text-white sm:text-5xl">
            From gear blanks to precision finishing.
          </h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-slate-300 sm:text-lg">
            Integrated machining capabilities for large gears, shafts and critical industrial
            components — from CNC turning and gear cutting to precision grinding and inspection.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-6">
            <a
              href={`/${lang}/contact`}
              class="rounded-md bg-accent-500 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-accent-600"
            >
              Request a Quote ↗
            </a>
            <a
              href="#capabilities"
              class="border-b border-slate-500 pb-0.5 text-sm font-semibold text-slate-300 transition-colors hover:border-accent-400 hover:text-accent-400"
            >
              Explore Capabilities ↓
            </a>
          </div>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-7 sm:p-8">
          <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-slate-400">Manufacturing process</p>
          <h3 class="mt-3 font-display text-xl font-bold text-white">One connected workflow</h3>
          <ol class="mt-5">
            {['Rough machining', 'Gear cutting & shaping', 'Heat treatment', 'Precision grinding', 'Final inspection'].map((s, idx) => (
              <li class="flex items-center gap-4 border-t border-white/10 py-3 text-sm text-slate-200">
                <span class="w-6 font-display text-xs font-bold text-accent-400">{String(idx + 1).padStart(2, '0')}</span>
                {s}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-100 bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid py-8 sm:grid-cols-3">
        {[
          ['50+', 'Machine tools (per published inventory)'],
          ['Ø3,000 mm', 'Listed external gear-grinding diameter'],
          ['M50', 'Listed maximum gear-grinding module'],
        ].map(([num, label], idx) => (
          <div class:list={[
            'px-2 py-3 sm:border-r sm:border-slate-100 sm:px-8',
            idx === 0 && 'sm:pl-0',
            idx === 2 && 'sm:border-r-0',
          ]}>
            <p class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">{num}</p>
            <p class="mt-1 text-xs text-slate-500 sm:text-sm">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="capabilities" class="scroll-mt-24 bg-steel-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-accent-500">What we do</p>
          <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Machining capabilities</h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-slate-600">
          Find the right process for your part. Detailed machine lists and work envelopes appear in
          the sections below.
        </p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ['01', 'Gear Grinding', 'External and internal gear tooth finishing with specialized profile-grinding equipment.', 'gear-grinding'],
          ['02', 'Gear Cutting', 'Gear hobbing, shaping, CNC gear milling and chamfering for large gears.', 'gear-cutting'],
          ['03', 'CNC Turning', 'Horizontal and vertical turning of shafts, rings, blanks and rotational parts.', 'turning'],
          ['04', 'Machining Centers', '3-axis, 4-axis and gantry machining for milled features and multi-face parts.', 'machining-centers'],
          ['05', 'Precision Grinding', 'Internal, cylindrical, surface and other specialized finishing operations.', 'grinding-machines'],
          ['06', 'Supporting Machining', 'Boring, radial drilling, wire EDM, sawing and other preparation operations.', 'additional-machining'],
        ].map(([num, title, desc, anchor]) => (
          <a
            href={`#${anchor}`}
            class="group rounded-xl border border-slate-200 bg-white p-6 transition-colors hover:border-steel-300"
          >
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-bold tracking-wider text-accent-500">{num}</span>
              <svg class="h-4 w-4 text-slate-300 transition-colors group-hover:text-accent-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 7l-10 10M7 7h10v10"></path>
              </svg>
            </div>
            <h3 class="mt-4 font-display text-lg font-bold text-ink">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{desc}</p>
          </a>
        ))}
      </div>
      <div class="mt-10 flex flex-col items-start justify-between gap-6 border-t border-slate-200 pt-8 sm:flex-row sm:items-center">
        <div>
          <p class="font-display text-lg font-bold text-ink">Have a part drawing ready?</p>
          <p class="mt-1.5 text-sm text-slate-600">Share the dimensions, material, tolerances and quantity for a feasibility review.</p>
        </div>
        <a
          href={`/${lang}/contact`}
          class="whitespace-nowrap rounded-md border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-ink transition-colors hover:border-accent-500 hover:text-accent-600"
        >
          Discuss Your Project ↗
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl space-y-16 px-4 sm:px-6">
      {categories.map((c) => (
        <div id={c.id} class="scroll-mt-24">
          <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">{c.title}</h2>
          {c.note && <p class="mt-2 text-slate-600">{c.note}</p>}

          {c.photos.length > 0 && (
            <div class:list={['mt-6 grid gap-6', c.photos.length > 1 && 'sm:grid-cols-2']}>
              {c.photos.map((p) => (
                <div class:list={[
                  'overflow-hidden rounded-lg border border-slate-100 bg-white shadow-sm',
                  c.photos.length === 1 && 'sm:max-w-[calc(50%-0.75rem)]',
                ]}>
                  <EquipPhoto src={p.img} name={p.model} fit="contain" class="aspect-[4/3] rounded-none border-0 ring-0" />
                  <div class="border-t border-slate-100 p-4 sm:p-5">
                    <p class="font-display font-bold text-ink">{p.model}</p>
                    <p class="mt-0.5 text-sm font-medium text-accent-500">{p.spec}</p>
                    <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{p.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          )}

          <EquipTable head={['Model', 'Capacity']} rows={c.rows} />
        </div>
      ))}

      <div id="additional-machining" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">Additional Machining</h2>
        <div class="mt-6 space-y-8">
          <EquipTable title="Boring & Drilling" head={['Model', 'Capacity']} rows={boringDrilling} />
          <EquipTable title="Wire EDM" head={['Model', 'Capacity']} rows={wireCutting} />
          <div class="rounded-lg border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
            <h3 class="font-display text-lg font-bold text-ink">Sawing & Rough Machining</h3>
            <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
              {sawingRough.map((p) => (
                <li class="flex items-start gap-2 rounded-xl bg-steel-50 px-3.5 py-2.5 text-sm text-slate-600">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {p}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <EquipTip placeholder="Equipment photos to be added" />
  <CTA lang={lang} />
</Base>
