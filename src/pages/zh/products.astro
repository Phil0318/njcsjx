---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';

const lang = 'zh' as const;

type Photo = { file: string; caption: string; fit?: 'cover' | 'contain' };

const families = [
  {
    id: 'gears-ring-gears',
    name: '齿轮与齿圈',
    desc: '内齿圈、外齿圈、齿轮盘及特种齿形件，按客户规格加工并精磨至成品。',
    process: '滚齿 · 热处理 · 磨齿',
    photos: [
      { file: 'IMG_0099_external-ring-gear.webp', caption: '外齿圈' },
      { file: 'IMG_0143_internal-ring-gear.webp', caption: '内齿圈' },
      { file: 'internal-ring-gear.webp', caption: '内齿圈' },
      { file: 'internal-tooth-ring.webp', caption: '内齿圈（齿面）' },
      { file: 'ring-gear-face.webp', caption: '齿圈端面' },
      { file: 'spoked-wheel.webp', caption: '辐板齿轮' },
      { file: 'large-helical-gear.webp', caption: '大型斜齿轮' },
      { file: 'helical-ring-stack.webp', caption: '人字齿 / 重载齿' },
      { file: 'gear-wheel-row.webp', caption: '现场产品照片' },
      { file: 'bored-gear.webp', caption: '镗孔齿轮' },
      { file: 'IMG_0103_single-gear.webp', caption: '单件齿轮' },
    ] as Photo[],
  },
  {
    id: 'pinions-gear-shafts',
    name: '小齿轮与齿轮轴',
    desc: '从毛坯到成齿的小齿轮与齿轮轴，包括海上钻井平台爬升齿轮轴。',
    process: '车削 · 滚齿 · 热处理 · 精磨',
    photos: [
      { file: 'upright-pinion-shaft.webp', caption: '立式小齿轮轴' },
      { file: 'long-pinion-shaft.webp', caption: '长小齿轮轴', fit: 'contain' },
      { file: 'four-pinion-shafts.webp', caption: '小齿轮轴' },
      { file: 'IMG_0121_pinion-shafts-front.webp', caption: '小齿轮轴（正面）' },
      { file: 'IMG_0122_pinion-shafts-overhead.webp', caption: '小齿轮轴（俯视）' },
      { file: 'coarse-pinion-batch.webp', caption: '小齿轮批量' },
      { file: 'pinion-hub-detail.webp', caption: '小齿轮轮毂细节' },
      { file: 'helical-pinion-and-wheel.webp', caption: '斜齿小齿轮与大齿轮' },
      { file: 'IMG_0100_coarse-tooth-gear-shaft.webp', caption: '粗齿齿轮轴' },
      { file: 'flanged-gear-shaft.webp', caption: '法兰齿轮轴' },
      { file: 'IMG_0130_jacking-shaft.webp', caption: '爬升齿轮轴' },
      { file: 'IMG_0131_jacking-shaft-side.webp', caption: '爬升齿轮轴（侧面）' },
    ] as Photo[],
  },
  {
    id: 'planetary-compound',
    name: '行星、双联及特种齿轮',
    desc: '行星架、太阳轮、双联齿轮及复合齿轮组件，用于行星传动与重载驱动系统。',
    process: '滚齿 · 插齿 · 渗碳淬火 · 磨齿',
    photos: [
      { file: 'planet-carrier.webp', caption: '行星架' },
      { file: 'planet-gear-pin.webp', caption: '行星轮销轴' },
      { file: 'sun-gear.webp', caption: '太阳轮' },
      { file: 'IMG_0129_wind-sun-gear.webp', caption: '风电太阳轮' },
      { file: 'IMG_0125_double-gear.webp', caption: '双联齿轮' },
      { file: 'compound-gear-batch.webp', caption: '复合齿轮批量' },
      { file: 'drum-gear-coupling.webp', caption: '鼓形齿联轴器' },
      { file: 'welded-gear.webp', caption: '焊接齿轮' },
      { file: 'eccentric-shaft.webp', caption: '偏心轴' },
      { file: 'helical-gear-assembly.webp', caption: '斜齿轮组件' },
    ] as Photo[],
  },
  {
    id: 'shafts-components',
    name: '定制轴类及相关零件',
    desc: '按图纸加工、热处理并磨削的轴、轴套、壳体及相关零件。',
    process: '车削 · 调质 · 精磨',
    photos: [
      { file: 'support-shaft.webp', caption: '支撑轴' },
      { file: 'gear-shaft-and-sleeve.webp', caption: '齿轮轴与轴套' },
      { file: 'gear-shaft-batch.webp', caption: '齿轮轴批量' },
      { file: 'stacked-shafts.webp', caption: '轴类零件' },
      { file: 'painted-housing.webp', caption: '涂漆壳体' },
      { file: 'pin-batch.webp', caption: '销轴' },
      { file: 'packed-gears-side.webp', caption: '成品齿轮装箱（侧面）' },
      { file: 'packed-gears-top.webp', caption: '成品齿轮装箱（俯视）' },
    ] as Photo[],
  },
];
---

<Base
  lang={lang}
  title="产品展示 — 工业齿轮与轴类 | 南京长升机械工程有限公司"
  description="按图纸制造的齿轮与齿圈、小齿轮与齿轮轴、行星与双联齿轮及定制轴类零件，工厂位于江苏南京。"
>
  <section class="page-heading bg-ink">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-12 sm:pt-24 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent-400">产品展示</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">按图纸制造的齿轮与轴类零件。</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-300">
        以下零件均由南京长升在工厂内完成加工、热处理、磨削与检验，全部按客户图纸生产。
      </p>
    </div>
  </section>

  <!-- Family navigation -->
  <nav aria-label="产品分类" class="sticky top-16 z-40 border-b border-slate-100 bg-white/95 backdrop-blur">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 flex gap-2 overflow-x-auto py-3">
      {families.map((f) => (
        <a
          href={`#${f.id}`}
          class="whitespace-nowrap rounded-full border border-steel-200 px-4 py-1.5 text-sm font-medium text-steel-700 transition-colors hover:border-steel-500 hover:bg-steel-50"
        >
          {f.name}
        </a>
      ))}
    </div>
  </nav>

  {families.map((f, i) => (
    <section id={f.id} class:list={['py-16 sm:py-20', i % 2 === 1 && 'bg-steel-50']}>
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="max-w-3xl">
          <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">{f.name}</h2>
          <p class="mt-3 text-base leading-relaxed text-slate-600">{f.desc}</p>
          <p class="mt-3 inline-block rounded-md bg-steel-50 px-2.5 py-1 text-xs font-medium text-steel-600">{f.process}</p>
        </div>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {f.photos.map((p) => (
            <figure class="group overflow-hidden rounded-lg border border-slate-100 bg-white shadow-sm">
              <div class="aspect-[4/3] overflow-hidden bg-steel-100">
                <img
                  src={`/products/${p.file}`}
                  alt={`${p.caption}，南京长升制造`}
                  loading="lazy"
                  width="1448"
                  height="1086"
                  class:list={[
                    'h-full w-full transition-transform duration-300 group-hover:scale-[1.02]',
                    p.fit === 'contain' ? 'object-contain' : 'object-cover',
                  ]}
                />
              </div>
              <figcaption class="flex items-center justify-between gap-3 border-t border-slate-100 px-4 py-2.5">
                <span class="text-sm font-medium text-ink">{p.caption}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <a href={`/${lang}/contact`} class="mt-8 inline-block text-sm font-semibold text-steel-700 hover:underline">
          询价：{f.name} →
        </a>
      </div>
    </section>
  ))}

  <!-- Heat treatment: a service, not a product family -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="rounded-lg border border-steel-200 bg-white p-8 sm:p-10">
        <div class="flex flex-wrap items-start justify-between gap-6">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-wider text-steel-600">服务</p>
            <h2 class="mt-2 font-display text-2xl font-bold text-ink sm:text-3xl">客户来料的热处理服务</h2>
            <p class="mt-3 text-base leading-relaxed text-slate-600">
              正火、退火、调质、渗碳、氮化、感应淬火等——可作为独立服务承接客户来料，
              单件重量 0.1&nbsp;kg 至 30&nbsp;t。
            </p>
          </div>
          <a
            href={`/${lang}/equipment/heat-treatment`}
            class="rounded-full bg-steel-700 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-steel-800"
          >
            热处理服务 →
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTA lang={lang} />
</Base>
