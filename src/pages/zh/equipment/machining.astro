---
import Base from '../../../layouts/Base.astro';
import CTA from '../../../components/CTA.astro';
import EquipTable from '../../../components/EquipTable.astro';
import EquipPhoto from '../../../components/EquipPhoto.astro';
import EquipTip from '../../../components/EquipTip.astro';

const lang = 'zh' as const;

const categories = [
  {
    id: 'gear-grinding',
    title: '磨齿设备',
    note: '德国 NILES / 霍夫曼系列成形磨齿机，最大模数 50 × 直径 3000 毫米（外齿）。',
    photos: [
      {
        img: '/equipment-photos/niles-zp30.jpg',
        model: 'NILES ZP30',
        spec: 'M50 × Φ3000（外齿）/ Φ2500（内齿）',
        desc: '厂内最大磨齿设备，服务海洋钻井平台等超大齿轮。',
      },
      {
        img: '/equipment-photos/niles-ze400s.jpg',
        model: 'NILES ZE400S',
        spec: 'M18 × Φ400',
        desc: '精密成形磨齿机，齿面高精度、低噪声。',
      },
    ],
    rows: [
      { m: 'NILES ZE400S', r: 'M18 × Φ400', i: '德国 NILES 精密成形磨齿机，适合中小模数齿轮精加工，齿面高精度、低噪声。' },
      { m: 'NILES ZE800', r: 'M32 × Φ800', i: '德国 NILES 成形磨齿机，用于中大型圆柱齿轮的高效精磨。' },
      { m: 'NILES ZE1200', r: 'M40 × Φ1200（外齿）/ M12 × Φ1100（内齿）', i: '德国 NILES 内外齿磨齿设备，满足直径 1200 mm 以内齿轮批量精磨。' },
      { m: 'NILES ZP20', r: 'M50 × Φ2000（外齿）/ Φ1480（内齿）', i: '大型齿轮磨齿设备，广泛用于风电与矿用齿轮。' },
      { m: 'NILES ZP30', r: 'M50 × Φ3000（外齿）/ Φ2500（内齿）', i: '厂内最大磨齿设备，外齿直径达 3000 mm，服务海洋钻井平台等超大齿轮。' },
      { m: 'Ri1250（德国霍夫曼）', r: 'M25 × Φ1200（外齿）', i: '高效成形磨齿机，适合大模数重载齿轮。' },
    ],
  },
  {
    id: 'turning',
    title: '数控车削',
    note: '数控卧车、数控立车与普通车床。',
    photos: [
      {
        img: '/equipment-photos/puma-480l.jpg',
        model: 'DOOSAN PUMA 480L',
        spec: 'Φ900 × 2042',
        desc: '韩国斗山高刚性数控卧车，重载高效车削。',
      },
      {
        img: '/equipment-photos/vl-160c.jpg',
        model: 'HONOR VL-160C 数控立车',
        spec: 'Φ2000 × 1250',
        desc: '荣田精机数控立式车床，高效车削大型回转体零件。',
      },
    ],
    rows: [
      { m: '数控卧车 DOOSAN PUMA 480L', r: 'Φ900 × 2042', i: '韩国斗山高刚性卧式车床，重载高效车削。' },
      { m: '数控卧车 CKBP6180/2', r: 'Φ800 × 2000', i: '安阳鑫盛数控卧式车床，用于大中型轴类零件加工。' },
      { m: '数控卧车 CK61125E/3', r: 'Φ1250 × 3000', i: '安阳鑫盛重型卧式车床，适合长轴类零件加工。' },
      { m: '数控立车 HONOR VL-160C', r: 'Φ2000 × 1250', i: '荣田精机数控立式车床，高效车削大型回转体零件。' },
      { m: '数控立车 SZ1600ATC', r: '工作台 Φ1600，回转 Φ2000 × 1250', i: '苏州三众数控立车，带刀库，自动化程度高。' },
      { m: '数控立车 C5225×16/10', r: '工作台 Φ2000，回转 Φ2500 × 1600', i: '齐一大型双柱立式车床，最大加工直径 2500 mm。' },
      { m: '普通车床 CA6266C / CW6180B / CW61125', r: 'Φ660–1250 × 3000', i: '沈阳机床等普通车床共 5 台，用于粗加工与辅助工序。' },
    ],
  },
  {
    id: 'gear-cutting',
    title: '齿轮加工机床',
    note: '滚齿、铣齿、插齿、倒角、刃磨，最大滚铣能力模数 50 × 直径 5000 毫米。',
    photos: [
      {
        img: '/equipment-photos/ykhl51160.jpg',
        model: 'YKHL51160 数控插齿机',
        spec: 'M20 × Φ1600（外）/ Φ2000（内）',
        desc: '武汉格威数控插齿机，用于大直径内齿与盲孔齿轮加工。',
      },
      {
        img: '/equipment-photos/y31125.jpg',
        model: 'Y31125 滚齿机',
        spec: 'M18 × Φ1250',
        desc: '重庆机床滚齿机，用于中大模数圆柱齿轮加工。',
      },
    ],
    rows: [
      { m: '数控铣齿机 YK31500L', r: 'M50 × Φ5000', i: '齐重数控大型铣齿机，最大模数 50、直径 5000 mm，服务超大齿轮成形铣削。' },
      { m: '数控铣齿机 YK83200', r: 'M26/32 × Φ2500，承重 10 t', i: '宜昌长机数控铣齿机，配备内外铣头，兼顾内齿加工。' },
      { m: '数控滚齿机 Y31200CNC', r: 'M32 × Φ2500', i: '河北卓昊数控滚齿机，用于大模数圆柱齿轮加工。' },
      { m: '滚齿机 Y3180H ×3', r: 'M10 × Φ800', i: '重庆机床滚齿机 3 台，用于中小模数圆柱齿轮成形加工。' },
      { m: '滚齿机 YA31125 / Y31125E', r: 'M18 × Φ1250', i: '重庆机床滚齿机，用于中大模数圆柱齿轮加工。' },
      { m: '数控插齿机 YKHL51160', r: 'M20 × Φ1600（外）/ Φ2000（内）', i: '武汉格威数控插齿机，用于大直径内齿与盲孔齿轮加工。' },
      { m: '插齿机 YK5150B', r: 'M8 × Φ500（外）/ Φ625（内）', i: '南京博程插齿机，用于中小内齿零件加工。' },
      { m: '倒角机 YKDV150B', r: 'M32 × Φ1500', i: '陕西虢西倒角机，用于齿轮端面与齿棱倒角。' },
      { m: '刃磨机床 M6425', r: '滚刀 Φ50–250', i: '武汉机床厂滚刀刃磨机床，保障滚刀精度。' },
    ],
  },
  {
    id: 'machining-centers',
    title: '加工中心',
    note: '',
    photos: [
      {
        img: '/equipment-photos/vm1580.jpg',
        model: 'SK-VM1580 立式加工中心',
        spec: '1500 × 800 × 700',
        desc: '南京高传四开立式加工中心，用于通用精密铣削。',
      },
      {
        img: '/equipment-photos/hcmc-1370.jpg',
        model: 'HCMC-1370 四轴加工中心',
        spec: '1300 × 700 × 660',
        desc: '协鸿工业四轴加工中心，一次装夹完成多面加工。',
      },
    ],
    rows: [
      { m: '龙门加工中心 SK-LMX2030', r: '2000 × 3000 × 1500', i: '南京高传四开大型龙门加工中心，适合大型结构件铣削。' },
      { m: '加工中心 SK-VM1580', r: '1500 × 800 × 700', i: '南京高传四开立式加工中心，用于通用精密铣削。' },
      { m: '加工中心 HCMC-1370', r: '1300 × 700 × 660', i: '协鸿工业四轴加工中心，一次装夹完成多面加工。' },
    ],
  },
  {
    id: 'grinding-machines',
    title: '精密磨削',
    note: '内圆、外圆、平面与曲轴磨削。',
    photos: [
      {
        img: '/equipment-photos/mg28100.jpg',
        model: 'MG28100 数控立磨',
        spec: 'Φ2000 × 800',
        desc: '无锡明鑫立式数控磨床，用于大型盘类、环类零件精密磨削。',
      },
    ],
    rows: [
      { m: '数控立磨 MG28100', r: 'Φ2000 × 800', i: '无锡明鑫立式数控磨床，用于大型盘类、环类零件内圆与外圆精密磨削。' },
      { m: '外圆磨床 M1350B', r: 'Φ630 × 3000', i: '外圆磨床，用于轴类零件外圆精密磨削。' },
      { m: '曲轴磨床 MQ8260', r: 'Φ580 × 1600', i: '汉江机床厂曲轴磨床，用于曲轴类零件磨削。' },
      { m: '内圆磨床 M250A', r: 'Φ150–500 × 450', i: '无锡机床内圆磨床，用于内孔精密磨削。' },
      { m: '平面磨床 M7132H', r: 'Φ600 × 2000', i: '平面磨床，用于零件平面精密磨削。' },
    ],
  },
];

const boringDrilling = [
  { m: '镗床 TK6110C/2', r: '镗轴 Φ110，最大镗孔 Φ2000', i: '卧式镗床，用于大型箱体类零件镗孔加工。' },
  { m: '镗床 TX6113C/2', r: '镗轴 Φ110，最大镗孔 Φ1300', i: '卧式镗床，用于大型零件镗孔加工。' },
  { m: '摇臂钻床 Z3080×25I', r: '最大钻孔 Φ80，跨距 2500', i: '摇臂钻床，用于大型零件钻孔与攻丝。' },
  { m: '摇臂钻床 Z3050×16I', r: '最大钻孔 Φ50，跨距 1600', i: '摇臂钻床，用于中型零件钻孔与攻丝。' },
  { m: '摇臂钻床 Z3132B', r: '最大钻孔 Φ32，跨距 1000', i: '摇臂钻床，用于中小零件钻孔。' },
];

const wireCutting = [
  { m: '线切割机 DK7763', r: 'Φ600 × 630', i: '线切割机床，用于复杂轮廓与精密模具加工。' },
];

const sawingRough = [
  '锯床 GW4028B / GB4250',
  '粗加工分厂：卧车 C6136A-D、CA6266C、C6140D、CW6180B、CW61125、CA6140A、C6150D、CK6280B、CK6140、C5116A',
  '粗加工分厂：龙门铣 SW-4200（4000 × 2000 × 1350）、万能铣 X6140',
];
---

<Base
  lang={lang}
  title="机械加工设备 — 南京长升机械工程有限公司"
  description="长升机械加工设备：德国 NILES 磨齿机最大模数50×直径3000毫米、韩国斗山 PUMA 480L、数控立车、滚齿/铣齿/插齿机床、龙门加工中心等 50 余台套。"
>
  <section class="page-heading bg-ink">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-16 sm:pt-24 sm:pb-20">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.13em] text-accent-400">工业机械加工能力</p>
          <h1 class="mt-6 max-w-xl font-display text-4xl font-bold leading-[1.1] tracking-tight text-white sm:text-5xl">
            从齿轮毛坯到精密成品。
          </h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-slate-300 sm:text-lg">
            面向大型齿轮、轴类与关键工业零件的一体化加工能力——
            从数控车削、齿轮切削到精密磨削与最终检测。
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-6">
            <a
              href={`/${lang}/contact`}
              class="rounded-md bg-accent-500 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-accent-600"
            >
              立即询价 ↗
            </a>
            <a
              href="#capabilities"
              class="border-b border-slate-500 pb-0.5 text-sm font-semibold text-slate-300 transition-colors hover:border-accent-400 hover:text-accent-400"
            >
              浏览加工能力 ↓
            </a>
          </div>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-7 sm:p-8">
          <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-slate-400">制造流程</p>
          <h3 class="mt-3 font-display text-xl font-bold text-white">一条连贯的制造流程</h3>
          <ol class="mt-5">
            {['粗加工', '齿轮切削', '热处理', '精密磨削', '最终检测'].map((s, idx) => (
              <li class="flex items-center gap-4 border-t border-white/10 py-3 text-sm text-slate-200">
                <span class="w-6 font-display text-xs font-bold text-accent-400">{String(idx + 1).padStart(2, '0')}</span>
                {s}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-100 bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid py-8 sm:grid-cols-3">
        {[
          ['50+', '台套机械加工设备（按设备清单）'],
          ['Φ3000 mm', '最大外齿磨齿直径'],
          ['M50', '最大磨齿模数'],
        ].map(([num, label], idx) => (
          <div class:list={[
            'px-2 py-3 sm:border-r sm:border-slate-100 sm:px-8',
            idx === 0 && 'sm:pl-0',
            idx === 2 && 'sm:border-r-0',
          ]}>
            <p class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">{num}</p>
            <p class="mt-1 text-xs text-slate-500 sm:text-sm">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="capabilities" class="scroll-mt-24 bg-steel-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-accent-500">我们能做什么</p>
          <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">机械加工能力</h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-slate-600">
          为您的零件找到合适的工艺。下方各节提供详细设备清单与加工范围。
        </p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ['01', '磨齿设备', '外齿与内齿成形磨削，最高模数 50。', 'gear-grinding'],
          ['02', '齿轮加工机床', '滚齿、插齿、数控铣齿与倒角。', 'gear-cutting'],
          ['03', '数控车削', '卧式与立式车削，覆盖轴类、齿坯与齿圈。', 'turning'],
          ['04', '加工中心', '三轴、四轴与龙门加工。', 'machining-centers'],
          ['05', '精密磨削', '内圆、外圆、平面与曲轴磨削。', 'grinding-machines'],
          ['06', '其他机械加工', '镗削、钻削、线切割与锯切。', 'additional-machining'],
        ].map(([num, title, desc, anchor]) => (
          <a
            href={`#${anchor}`}
            class="group rounded-xl border border-slate-200 bg-white p-6 transition-colors hover:border-steel-300"
          >
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-bold tracking-wider text-accent-500">{num}</span>
              <svg class="h-4 w-4 text-slate-300 transition-colors group-hover:text-accent-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 7l-10 10M7 7h10v10"></path>
              </svg>
            </div>
            <h3 class="mt-4 font-display text-lg font-bold text-ink">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{desc}</p>
          </a>
        ))}
      </div>
      <div class="mt-10 flex flex-col items-start justify-between gap-6 border-t border-slate-200 pt-8 sm:flex-row sm:items-center">
        <div>
          <p class="font-display text-lg font-bold text-ink">手头有零件图纸？</p>
          <p class="mt-1.5 text-sm text-slate-600">分享尺寸、材料、公差与数量，评估制造可行性。</p>
        </div>
        <a
          href={`/${lang}/contact`}
          class="whitespace-nowrap rounded-md border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-ink transition-colors hover:border-accent-500 hover:text-accent-600"
        >
          咨询您的项目 ↗
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl space-y-16 px-4 sm:px-6">
      {categories.map((c) => (
        <div id={c.id} class="scroll-mt-24">
          <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">{c.title}</h2>
          {c.note && <p class="mt-2 text-slate-600">{c.note}</p>}

          {c.photos.length > 0 && (
            <div class:list={['mt-6 grid gap-6', c.photos.length > 1 && 'sm:grid-cols-2']}>
              {c.photos.map((p) => (
                <div class:list={[
                  'overflow-hidden rounded-lg border border-slate-100 bg-white shadow-sm',
                  c.photos.length === 1 && 'sm:max-w-[calc(50%-0.75rem)]',
                ]}>
                  <EquipPhoto src={p.img} name={p.model} fit="contain" class="aspect-[4/3] rounded-none border-0 ring-0" />
                  <div class="border-t border-slate-100 p-4 sm:p-5">
                    <p class="font-display font-bold text-ink">{p.model}</p>
                    <p class="mt-0.5 text-sm font-medium text-accent-500">{p.spec}</p>
                    <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{p.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          )}

          <EquipTable head={['设备型号', '加工范围']} rows={c.rows} />
        </div>
      ))}

      <div id="additional-machining" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">其他机械加工</h2>
        <div class="mt-6 space-y-8">
          <EquipTable title="镗削与钻削" head={['设备型号', '加工范围']} rows={boringDrilling} />
          <EquipTable title="线切割" head={['设备型号', '加工范围']} rows={wireCutting} />
          <div class="rounded-lg border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
            <h3 class="font-display text-lg font-bold text-ink">锯切与粗加工</h3>
            <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
              {sawingRough.map((p) => (
                <li class="flex items-start gap-2 rounded-xl bg-steel-50 px-3.5 py-2.5 text-sm text-slate-600">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {p}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <EquipTip placeholder="设备照片待补充" />
  <CTA lang={lang} />
</Base>
