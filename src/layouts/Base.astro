---
import '../styles/global.css';
import { ui, type Lang } from '../i18n/ui';
import { SITE, GA_MEASUREMENT_ID } from '../config';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const t = ui[lang];
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';

const path = Astro.url.pathname.replace(/\/$/, '');
let altUrl = otherLang === 'zh' ? '/zh/' : '/en/';
if (path.startsWith('/zh/')) altUrl = path.replace(/^\/zh/, '/en') + '/';
if (path.startsWith('/en/')) altUrl = path.replace(/^\/en/, '/zh') + '/';

const homeHref = `/${lang}/`;
const navItems = [
  { href: `/${lang}/`, label: t.nav.home },
  { href: `/${lang}/about`, label: t.nav.about },
  { href: `/${lang}/products`, label: t.nav.products },
  { href: `/${lang}/certificates`, label: t.nav.certificates },
  { href: `/${lang}/contact`, label: t.nav.contact },
];

const equipmentHref = `/${lang}/equipment`;
const equipmentSub = [
  { href: equipmentHref, label: t.nav.equipmentOverview },
  { href: `${equipmentHref}/machining`, label: t.nav.machining },
  { href: `${equipmentHref}/heat-treatment`, label: t.nav.heatTreat },
  { href: `${equipmentHref}/inspection`, label: t.nav.inspection },
];

const subItemClass = 'block px-5 py-2 text-sm font-medium text-ink transition-colors hover:bg-steel-50 hover:text-accent-500';

const isActive = (href: string) =>
  href === homeHref
    ? path === '' || path === `/${lang}`
    : path.startsWith(href.replace(/\/$/, ''));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, SITE.url).href} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'zh-CN' : 'en'} href={new URL(Astro.url.pathname, SITE.url).href} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-CN'} href={new URL(altUrl, SITE.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(altUrl, SITE.url).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={lang === 'zh' ? SITE.nameZh : SITE.nameEn} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, SITE.url).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    {
      GA_MEASUREMENT_ID && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
          <script define:vars={{ GA_MEASUREMENT_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', GA_MEASUREMENT_ID);
          </script>
        </>
      )
    }
  </head>
  <body class="min-h-screen flex flex-col bg-white">
    <a class="skip-link" href="#main-content">{lang === 'zh' ? '跳至正文' : 'Skip to content'}</a>
    <header class="sticky top-0 z-50 bg-ink text-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href={homeHref} class="flex items-center gap-2.5">
          <span class="grid h-9 w-9 place-items-center rounded-lg bg-accent-500">
            <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.3 3.9a1.6 1.6 0 012.4-1l.7.5a1.6 1.6 0 002.2-.5l.5-.8a1.6 1.6 0 012.5 1.5l-.1.9a1.6 1.6 0 001.6 1.7h1a1.6 1.6 0 011.2 2.6l-.5.7a1.6 1.6 0 00.5 2.2l.8.5a1.6 1.6 0 01-1.5 2.5l-.9-.1a1.6 1.6 0 00-1.7 1.6v1a1.6 1.6 0 01-2.6 1.2l-.7-.5a1.6 1.6 0 00-2.2.5l-.5.8a1.6 1.6 0 01-2.5-1.5l.1-.9a1.6 1.6 0 00-1.6-1.7h-1a1.6 1.6 0 01-1.2-2.6l.5-.7a1.6 1.6 0 00-.5-2.2l-.8-.5a1.6 1.6 0 011.5-2.5l.9.1a1.6 1.6 0 001.7-1.6v-1a1.6 1.6 0 012.6-1.2l.7.5z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </span>
          <span class="leading-tight">
            <span class="block font-display text-lg font-bold tracking-wide">{SITE.short}</span>
            <span class="block text-[10px] text-slate-400">
              {lang === 'zh' ? '南京长升机械工程有限公司' : 'Machinery Engineering Co., Ltd.'}
            </span>
          </span>
        </a>

        <nav class="hidden lg:flex items-center gap-7">
          {navItems.slice(0, 2).map((item) => (
            <a
              href={item.href}
              class:list={[
                'text-sm font-medium transition-colors',
                isActive(item.href) ? 'text-accent-400' : 'text-slate-300 hover:text-white',
              ]}
            >
              {item.label}
            </a>
          ))}
          <div class="group relative">
            <a
              href={equipmentHref}
              class:list={[
                'flex items-center gap-1.5 text-sm font-medium transition-colors',
                isActive(equipmentHref) ? 'text-accent-400' : 'text-slate-300 hover:text-white',
              ]}
            >
              {t.nav.equipment}
              <svg class="h-3.5 w-3.5 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
              </svg>
            </a>
            <div class="invisible absolute left-1/2 top-full z-50 -translate-x-1/2 pt-3 opacity-0 transition-all group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <div class="w-64 overflow-hidden rounded-2xl bg-white py-2 shadow-xl ring-1 ring-slate-900/10">
                {equipmentSub.map((sub) => (
                  <a href={sub.href} class:list={[subItemClass, sub.href === equipmentHref && 'font-semibold']}>
                    {sub.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
          {navItems.slice(2).map((item) => (
            <a
              href={item.href}
              class:list={[
                'text-sm font-medium transition-colors',
                isActive(item.href) ? 'text-accent-400' : 'text-slate-300 hover:text-white',
              ]}
            >
              {item.label}
            </a>
          ))}
          <a
            href={altUrl}
            class="flex items-center gap-1 rounded-full border border-white/20 px-2 py-1 text-xs font-semibold transition-colors hover:border-accent-400"
            title={otherLang === 'zh' ? '切换到中文' : 'Switch to English'}
          >
            <span
              class:list={[
                'rounded-full px-1.5 py-0.5 transition-colors',
                lang === 'en' ? 'bg-accent-500 text-white' : 'text-slate-400',
              ]}
            >
              EN
            </span>
            <span
              class:list={[
                'rounded-full px-1.5 py-0.5 transition-colors',
                lang === 'zh' ? 'bg-accent-500 text-white' : 'text-slate-400',
              ]}
            >
              中文
            </span>
          </a>
          <a
            href={`/${lang}/contact`}
            class="rounded-full bg-accent-500 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-600"
          >
            {t.nav.quote}
          </a>
        </nav>

        <button
          id="menu-btn"
          class="lg:hidden rounded-lg p-2 text-slate-300 hover:bg-white/10"
          aria-label={lang === 'zh' ? '导航菜单' : 'Navigation menu'}
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

      <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 bg-ink">
        <div class="px-4 py-4 space-y-1">
          {navItems.slice(0, 2).map((item) => (
            <a
              href={item.href}
              class:list={[
                'block rounded-lg px-3 py-2.5 text-sm font-medium',
                isActive(item.href) ? 'bg-white/10 text-accent-400' : 'text-slate-300 hover:bg-white/5',
              ]}
            >
              {item.label}
            </a>
          ))}
          <a
            href={equipmentHref}
            class:list={[
              'block rounded-lg px-3 py-2.5 text-sm font-medium',
              isActive(equipmentHref) ? 'bg-white/10 text-accent-400' : 'text-slate-300 hover:bg-white/5',
            ]}
          >
            {t.nav.equipment}
          </a>
          <div class="ml-4 space-y-1 border-l border-white/10 pl-3">
            {equipmentSub.slice(1).map((sub) => (
              <a href={sub.href} class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-400 hover:bg-white/5 hover:text-white">
                {sub.label}
              </a>
            ))}
          </div>
          {navItems.slice(2).map((item) => (
            <a
              href={item.href}
              class:list={[
                'block rounded-lg px-3 py-2.5 text-sm font-medium',
                isActive(item.href) ? 'bg-white/10 text-accent-400' : 'text-slate-300 hover:bg-white/5',
              ]}
            >
              {item.label}
            </a>
          ))}
          <div class="flex items-center gap-3 pt-2 px-3">
            <a
              href={`/${lang}/contact`}
              class="flex-1 rounded-full bg-accent-500 px-5 py-2.5 text-center text-sm font-semibold text-white hover:bg-accent-600"
            >
              {t.nav.quote}
            </a>
            <a
              href={altUrl}
              class="flex items-center justify-center gap-1 rounded-full border border-white/20 px-3 py-2.5 text-xs font-semibold transition-colors hover:border-accent-400"
              title={otherLang === 'zh' ? '切换到中文' : 'Switch to English'}
            >
              <span class:list={['rounded-full px-1.5 py-0.5', lang === 'en' ? 'bg-accent-500 text-white' : 'text-slate-400']}>
                EN
              </span>
              <span class:list={['rounded-full px-1.5 py-0.5', lang === 'zh' ? 'bg-accent-500 text-white' : 'text-slate-400']}>
                中文
              </span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="bg-ink text-slate-300">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        <div class="sm:col-span-2 lg:col-span-1">
          <div class="flex items-center gap-2.5">
            <span class="grid h-9 w-9 place-items-center rounded-lg bg-accent-500">
              <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.3 3.9a1.6 1.6 0 012.4-1l.7.5a1.6 1.6 0 002.2-.5l.5-.8a1.6 1.6 0 012.5 1.5l-.1.9a1.6 1.6 0 001.6 1.7h1a1.6 1.6 0 011.2 2.6l-.5.7a1.6 1.6 0 00.5 2.2l.8.5a1.6 1.6 0 01-1.5 2.5l-.9-.1a1.6 1.6 0 00-1.7 1.6v1a1.6 1.6 0 01-2.6 1.2l-.7-.5a1.6 1.6 0 00-2.2.5l-.5.8a1.6 1.6 0 01-2.5-1.5l.1-.9a1.6 1.6 0 00-1.6-1.7h-1a1.6 1.6 0 01-1.2-2.6l.5-.7a1.6 1.6 0 00-.5-2.2l-.8-.5a1.6 1.6 0 011.5-2.5l.9.1a1.6 1.6 0 001.7-1.6v-1a1.6 1.6 0 012.6-1.2l.7.5z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </span>
            <div class="leading-tight">
              <span class="block font-display text-lg font-bold text-white">{SITE.short}</span>
              <span class="block text-[10px] text-slate-400">
                {lang === 'zh' ? '南京长升机械工程有限公司' : 'Nanjing Changsheng Machinery'}
              </span>
            </div>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-slate-400">{t.footer.blurb}</p>
        </div>
        <div>
          <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-white">
            {t.footer.pages}
          </h3>
          <ul class="mt-4 space-y-2.5 text-sm">
            {navItems.map((item) => (
              <li>
                <a href={item.href} class="text-slate-400 transition-colors hover:text-accent-400">
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              <a href={altUrl} class="text-slate-400 transition-colors hover:text-accent-400">
                {t.otherLang}
              </a>
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-white">
            {t.footer.capabilities}
          </h3>
          <ul class="mt-4 space-y-2.5 text-sm text-slate-400">
            <li>{t.footer.gearMachining}</li>
            <li>{t.footer.heatTreatment}</li>
            <li>{t.footer.inspection}</li>
          </ul>
        </div>
        <div>
          <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-white">
            {t.footer.contact}
          </h3>
          <a href={`mailto:${SITE.email}`} class="mt-4 inline-block text-sm font-medium text-accent-400 hover:text-accent-500">
            {SITE.email}
          </a>
          {SITE.phone && <p class="mt-2 text-sm text-slate-400">{SITE.phone}</p>}
          <p class="mt-2 text-sm text-slate-400">
            {lang === 'zh' ? SITE.addressZh : SITE.addressEn}
          </p>
          <p class="mt-3 text-xs text-slate-500">{t.footer.responseTime}</p>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 py-5 text-sm text-slate-500">
          © {new Date().getFullYear()} {SITE.nameZh} · {SITE.nameEn} · {t.footer.rights}
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        const open = menu?.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
