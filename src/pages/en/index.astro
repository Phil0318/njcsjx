---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';

const lang = 'en' as const;

const capabilities = [
  {
    title: 'Full-process gear machining',
    body: 'Turning, hobbing, milling, shaping, heat treatment, shot peening, gear grinding, internal grinding, and chamfering — all in one plant, with gear grinding up to module 50 × Ø3000 mm.',
    points: ['6 NILES gear grinders (ZE400S–ZP30)', 'CNC vertical lathes up to Ø2500 mm', '3/4-axis machining centers, 5-axis wire EDM'],
  },
  {
    title: 'Metal heat treatment',
    body: 'Normalizing, annealing, quenching & tempering, carburizing, carbonitriding, nitriding, nitrocarburizing, vacuum oil quenching, high-pressure gas quenching, induction hardening, shot peening, and blackening for ferrous, non-ferrous, and special materials.',
    points: ['Single parts from 0.1 kg to 30 t', 'Annual capacity ~50,000 t', 'Large pit carburizing furnaces up to Φ4000 × 2500'],
  },
  {
    title: 'Inspection & metrology',
    body: 'Full quality control from raw material to finished part: gear measurement, CMM inspection, NDT, hardness & metallographic analysis, and mechanical testing.',
    points: ['Gleason 1000GMS gear analyzer', 'Three CMMs (Hexagon / DEA / VENUS)', 'Ultrasonic & magnetic particle NDT, spectrometry'],
  },
];

const industries = [
  { label: 'Offshore drilling', img: '/industries/offshore.png' },
  { label: 'Wind power', img: '/industries/wind.png' },
  { label: 'Petrochemical', img: '/industries/petrochemical.png' },
  { label: 'Coal mining', img: '/industries/coal.png' },
  { label: 'Metallurgy', img: '/industries/metallurgy.png' },
  { label: 'Building materials', img: '/industries/building-materials.png' },
];
---

<Base
  lang={lang}
  title="Nanjing Changsheng Machinery Engineering Co., Ltd. — Gears & Heat Treatment"
  description="Nanjing Changsheng Machinery Engineering Co., Ltd. (est. 2006) specializes in full-process gear machining and metal heat treatment — gear grinding up to module 50 × Ø3000 mm, ~50,000 t annual heat-treatment capacity."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink">
    <div class="absolute -right-40 -top-40 h-[480px] w-[480px] rounded-full bg-steel-700/40 blur-3xl"></div>
    <div class="absolute -left-32 bottom-0 h-80 w-80 rounded-full bg-accent-500/10 blur-3xl"></div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 pt-20 pb-14 sm:pt-28 sm:pb-20">
      <p class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold tracking-wider text-steel-200">
        Changsheng — “Long Rising”: gears & thermal processing since 2006
      </p>
      <h1 class="mt-6 max-w-3xl font-display text-4xl font-bold leading-tight text-white sm:text-5xl lg:text-6xl">
        A specialist in gears &<span class="text-accent-400"> heat treatment</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
        From blank to finished gear, from quenching & tempering to carburizing. Two decades of
        thermal-processing experience and 50+ machine tools — supplying critical parts for
        offshore drilling, wind power, mining, and petrochemical industries.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={`/${lang}/contact`}
          class="rounded-full bg-accent-500 px-8 py-3.5 font-semibold text-white shadow-lg shadow-accent-500/25 transition-transform hover:scale-105"
        >
          Request a Quote
        </a>
        <a
          href={`/${lang}/equipment`}
          class="rounded-full border border-white/25 px-8 py-3.5 font-semibold text-white transition-colors hover:border-accent-400 hover:text-accent-400"
        >
          View Equipment
        </a>
      </div>
      <div class="mt-14 grid grid-cols-2 gap-4 sm:grid-cols-5">
        {
          [
            ['2006', 'year founded'],
            ['286', 'employees'],
            ['45,000', 'm² workshops'],
            ['50k', 't/yr heat treatment'],
            ['100+', 'heat-treatment units'],
          ].map(([num, label]) => (
            <div class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10">
              <p class="font-display text-2xl font-bold text-accent-400 sm:text-3xl">{num}</p>
              <p class="mt-1 text-xs text-slate-400 sm:text-sm">{label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-steel-600">Capabilities</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ink sm:text-4xl">Three capabilities, one complete gear-part process.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          capabilities.map((c) => (
            <div class="rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
              <h3 class="font-display text-xl font-bold text-ink">{c.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{c.body}</p>
              <ul class="mt-5 space-y-2.5 text-sm text-slate-500">
                {c.points.map((p) => (
                  <li class="flex items-start gap-2">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {p}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="bg-steel-50 py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-steel-600">Industries served</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ink sm:text-4xl">Two decades in heavy-industry critical parts.</h2>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {industries.map((i) => (
          <div class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-100">
            <div class="overflow-hidden bg-steel-100">
              <img
                src={i.img}
                alt={i.label}
                loading="lazy"
                width="304"
                height="228"
                class="h-32 w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
            <p class="px-5 py-3.5 font-semibold text-ink">{i.label}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 rounded-2xl bg-ink p-8 sm:p-10">
        <div class="grid gap-6 sm:grid-cols-3">
          {[
            ['Mud-pump gears & shafts', 'Core drive parts for offshore drilling rigs'],
            ['Wind pitch gear shafts', 'Key components for wind turbines'],
            ['Electric-wheel double gears', 'Drive systems for mining vehicles'],
          ].map(([title, desc]) => (
            <div>
              <p class="font-display text-lg font-bold text-white">{title}</p>
              <p class="mt-1.5 text-sm text-slate-400">{desc}</p>
            </div>
          ))}
        </div>
        <a href={`/${lang}/products`} class="mt-8 inline-block rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-accent-400 hover:text-accent-400">
          View products →
        </a>
      </div>
    </div>
  </section>

  <!-- Culture -->
  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-steel-600">Company culture</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ink sm:text-4xl">Rigorous · Efficient · Pragmatic · Innovative</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          <span class="font-semibold text-ink">Teamwork, customer first, goal driven.</span>
          Sharing success with customers, development with employees, and progress with society —
          to be the professional gear and heat-treatment supplier.
        </p>
        <a href={`/${lang}/about`} class="mt-8 inline-block rounded-full bg-steel-700 px-7 py-3 font-semibold text-white transition-colors hover:bg-steel-800">
          About Changsheng →
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          ['58', 'engineers & technicians'],
          ['126', 'skilled workers'],
          ['100', 'mu site area'],
          ['50+', 'machining equipment'],
        ].map(([num, label]) => (
          <div class="rounded-3xl border border-slate-100 bg-white p-7 text-center shadow-sm">
            <p class="font-display text-3xl font-bold text-steel-600">{num}</p>
            <p class="mt-2 text-sm text-slate-600">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA lang={lang} />
</Base>
