---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import fs from 'node:fs';

const lang = 'en' as const;

const hasFile = (p: string) => fs.existsSync('public' + p);

const families = [
  {
    label: 'Gears & Ring Gears',
    desc: 'Internal and external ring gears, gear wheels, and specialty gear forms machined and finish-ground to specification.',
    img: '/products/IMG_0099_external-ring-gear.webp',
    alt: 'External ring gear manufactured by Changsheng',
    href: '/en/products/gears-ring-gears',
  },
  {
    label: 'Pinions & Gear Shafts',
    desc: 'Pinions and gear shafts produced from blank machining through gear cutting and finish grinding.',
    img: '/products/upright-pinion-shaft.webp',
    alt: 'Pinion shaft manufactured by Changsheng',
    href: '/en/products/pinions-gear-shafts',
  },
  {
    label: 'Planetary, Compound & Specialty Gears',
    desc: 'Planet carriers, sun gears, double gears, and compound gear assemblies for heavy drive systems.',
    img: '/products/planet-carrier.webp',
    alt: 'Planetary gear component manufactured by Changsheng',
    href: '/en/products/planetary-compound',
  },
  {
    label: 'Custom Shafts & Related Components',
    desc: 'Shafts, sleeves, and related components machined, heat-treated, and ground to customer drawings.',
    img: '/products/gear-shaft-and-sleeve.webp',
    alt: 'Gear shaft and sleeve manufactured by Changsheng',
    href: '/en/products/shafts-components',
  },
];

const facts = [
  ['2006', 'In business since'],
  ['ISO 9001:2015', 'Quality management certified'],
  ['ABS HT-0579098', 'Marine heat-treatment approval'],
  ['M50 × Ø3000', 'Maximum gear grinding capacity'],
];

const processSteps = [
  {
    n: '01',
    label: 'Blank Machining',
    hint: 'Turning & milling',
    capability: 'CNC turning to Ø2500 mm · machining centers',
    img: '/equipment-photos/vl-160c.jpg',
    alt: 'CNC vertical lathe at the Changsheng workshop',
    href: '/en/equipment/machining',
  },
  {
    n: '02',
    label: 'Gear Cutting',
    hint: 'Hobbing & shaping',
    capability: 'Hobbing and shaping for external and internal gears',
    img: '/equipment-photos/y31125.jpg',
    alt: 'Gear hobbing machine at the Changsheng workshop',
    href: '/en/equipment/machining',
  },
  {
    n: '03',
    label: 'Heat Treatment',
    hint: 'Carburizing & Q&T',
    capability: 'Pit furnaces to Φ4000 × 2500 mm · parts 0.1 kg–30 t',
    img: null,
    alt: '',
    href: '/en/equipment/heat-treatment',
  },
  {
    n: '04',
    label: 'Finish Grinding',
    hint: 'Gear & bore grinding',
    capability: 'Gear grinding to module 50 × Ø3000 mm · 6 NILES grinders',
    img: '/equipment-photos/niles-ze400s.jpg',
    alt: 'NILES ZE400S gear grinder at the Changsheng workshop',
    href: '/en/equipment/machining',
  },
  {
    n: '05',
    label: 'Final Inspection',
    hint: 'Measurement & NDT',
    capability: 'Gleason 1000GMS · three CMMs · UT/MT NDT',
    img: '/workshop/inspection-room.webp',
    alt: 'Inspection room at the Changsheng facility',
    href: '/en/equipment/inspection',
  },
];

const equipment = [
  {
    img: '/equipment-photos/niles-ze1200.jpg',
    alt: 'NILES ZE1200 gear grinder at the Changsheng workshop',
    name: 'NILES ZE1200',
    spec: 'Gear grinding',
  },
  {
    img: '/equipment-photos/puma-480l.jpg',
    alt: 'DOOSAN PUMA 480L CNC lathe at the Changsheng workshop',
    name: 'DOOSAN PUMA 480L',
    spec: 'CNC turning',
  },
  {
    img: '/equipment-photos/hcmc-1370.jpg',
    alt: 'HCMC-1370 machining center at the Changsheng workshop',
    name: 'HCMC-1370',
    spec: 'Machining center',
  },
];

const processVideos = [
  {
    step: '01',
    label: 'Blank Machining',
    video: '/videos/01-blank-machining.mp4',
    fallback: '/workshop/machine-shop-floor.webp',
    alt: 'Machine shop floor at the Changsheng facility',
  },
  {
    step: '02',
    label: 'Gear Cutting',
    video: '/videos/02-gear-cutting.mp4',
    fallback: '/workshop/machining-line.webp',
    alt: 'Machining line at the Changsheng facility',
  },
  { step: '03', label: 'Heat Treatment', video: '/videos/03-heat-treatment.mp4', fallback: null, alt: '' },
  {
    step: '04',
    label: 'Finish Grinding',
    video: '/videos/04-finish-grinding.mp4',
    fallback: '/equipment-photos/niles-zp30.jpg',
    alt: 'NILES ZP30 gear grinder at the Changsheng facility',
  },
  {
    step: '05',
    label: 'Final Inspection',
    video: '/videos/05-final-inspection.mp4',
    fallback: '/workshop/gear-inspection-setup.webp',
    alt: 'Gear inspection setup at the Changsheng facility',
  },
  {
    step: '06',
    label: 'Finished Product',
    video: '/videos/06-finished-product.mp4',
    fallback: '/products/IMG_0130_jacking-shaft.webp',
    alt: 'Finished jacking gear shaft manufactured by Changsheng',
  },
];

const industries = [
  {
    label: 'Offshore Drilling',
    desc: 'Mud-pump gear sets and jacking-system components for offshore drilling rigs, produced to ABS-approved heat-treatment procedures.',
    href: '/en/products/pinions-gear-shafts',
  },
  {
    label: 'Wind Power',
    desc: 'Sun gears and pitch-system shafts for wind turbines, carburized and finish-ground for fatigue-critical duty.',
    href: '/en/products/planetary-compound',
  },
  {
    label: 'Mining Equipment',
    desc: 'Electric-wheel double gears for mining haul trucks, hobbing, carburizing, and grinding completed in-house.',
    href: '/en/products/planetary-compound',
  },
];

const certs = [
  { img: '/certificates/iso-9001-1.jpg', label: 'ISO 9001:2015', alt: 'ISO 9001:2015 certificate' },
  { img: '/certificates/abs-ht-0579098-1.jpg', label: 'ABS heat treatment', alt: 'ABS heat treatment approval' },
  { img: '/certificates/ndt-cert-1.jpg', label: 'NDT inspection', alt: 'NDT inspection certificate' },
];
---

<Base
  lang={lang}
  title="Custom Gears, Shafts & Heat Treatment | Changsheng Machinery"
  description="Custom gears, shafts, machined components, and heat treatment services manufactured in Nanjing, China. Machining, gear cutting, precision grinding, and inspection."
>
  <!-- 1. Hero -->
  <section class="b1-hero">
    <div class="b1-hero-grid">
      <div class="b1-hero-copy">
        <p class="b1-eyebrow">NANJING CHANGSHENG MACHINERY</p>
        <h1>Custom components, from drawing to finished part</h1>
        <p class="b1-hero-intro">
          Machining, gear cutting, heat treatment, grinding, and inspection in one Nanjing facility.
        </p>
        <p class="b1-hero-intro b1-hero-intro-2">
          Send your drawing for a finished-component quote — or send parts for heat treatment.
        </p>
        <div class="b1-hero-actions">
          <a class="b1-btn b1-btn-primary" href="/en/contact">Request a Quote</a>
          <a class="b1-btn b1-btn-ghost" href="#product-families">See Our Work</a>
        </div>
        <p class="b1-hero-envelope">
          <span>Part envelope</span> Gears to module 50 × Ø3000&nbsp;mm · Shafts to Ø2500&nbsp;mm · Parts 0.1&nbsp;kg–30&nbsp;t
        </p>
      </div>
      <figure class="b1-hero-fig">
        <img
          src="/products/gear-shaft-batch.webp"
          alt="Gear shafts manufactured by Changsheng"
          width="1448"
          height="1086"
          fetchpriority="high"
        />
        <figcaption>Gear shafts at the Changsheng workshop.</figcaption>
      </figure>
    </div>
    <div class="b1-facts">
      {facts.map(([value, label]) => (
        <div class="b1-fact"><strong>{value}</strong><span>{label}</span></div>
      ))}
    </div>
  </section>

  <!-- 2. Product Families -->
  <section id="product-families" class="b1-section b1-section-gray">
    <div class="b1-container">
      <div class="b1-heading">
        <h2>Industrial Components Manufactured to Specification</h2>
        <p>Representative components for heavy industrial applications.</p>
      </div>
      <div class="b1-families">
        {families.map((f) => (
          <a class="b1-family" href={f.href}>
            <div class="b1-family-img">
              <img src={f.img} alt={f.alt} loading="lazy" width="1448" height="1086" />
            </div>
            <div class="b1-family-body">
              <h3>{f.label}</h3>
              <p>{f.desc}</p>
              <span class="b1-family-link">View products →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Integrated Manufacturing -->
  <section id="manufacturing" class="b1-section">
    <div class="b1-container">
      <div class="b1-heading">
        <h2>From Gear Blank to Final Inspection</h2>
        <p>
          Changsheng coordinates the key manufacturing processes needed to deliver finished gears and shafts
          to customer specifications.
        </p>
      </div>
      <ol class="b1-process">
        {processSteps.map((s) => (
          <li>
            <a class="b1-process-card" href={s.href}>
              <span class="b1-process-media">
                {s.img ? (
                  <img src={s.img} alt={s.alt} loading="lazy" width="600" height="450" />
                ) : (
                  <span class="b1-process-ph">Photo to be added</span>
                )}
              </span>
              <span class="b1-process-num">{s.n}</span>
              <span class="b1-process-label">{s.label}</span>
              <span class="b1-process-hint">{s.hint}</span>
              <span class="b1-process-cap">{s.capability}</span>
              <span class="b1-process-cta">Learn more →</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="b1-process-note">
        <em>Typical process route shown. Actual manufacturing steps depend on component drawings and specifications.</em>
      </p>

      <div class="b1-equip-head">
        <h3>The machines behind the process</h3>
        <a href="/en/equipment">Full equipment overview →</a>
      </div>
      <div class="b1-equip-strip">
        {equipment.map((e) => (
          <a href="/en/equipment/machining" class="b1-equip-card">
            <img src={e.img} alt={e.alt} loading="lazy" width="600" height="450" />
            <span class="b1-equip-name">{e.name}</span>
            <span class="b1-equip-spec">{e.spec}</span>
          </a>
        ))}
      </div>
      <p class="b1-capacity">
        Gear grinding to module 50 × Ø3000&nbsp;mm · CNC turning to Ø2500&nbsp;mm · heat treatment of single
        parts from 0.1&nbsp;kg to 30&nbsp;t.
      </p>
    </div>
  </section>

  <!-- 4. Featured Component -->
  <section id="featured" class="b1-section b1-section-gray">
    <div class="b1-container">
      <div class="b1-heading">
        <h2>The Route, End to End</h2>
      </div>

      <div class="b1-process-gallery">
        <div class="b1-gallery-head">
          <p class="b1-gallery-note">The videos show the manufacturing route from blank machining to the final inspected product.</p>
          <div class="b1-gallery-controls">
            <button type="button" class="b1-gallery-btn" id="b1-gallery-prev" aria-label="Previous step">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg>
            </button>
            <button type="button" class="b1-gallery-btn" id="b1-gallery-next" aria-label="Next step">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
            </button>
          </div>
        </div>
        <div class="b1-gallery-track" id="b1-gallery-track">
          {processVideos.map((v) => (
            <figure class="b1-gallery-tile">
              {hasFile(v.video) ? (
                <video src={v.video} controls playsinline preload="metadata" aria-label={`${v.label} video`}></video>
              ) : v.fallback ? (
                <img src={v.fallback} alt={v.alt} loading="lazy" width="1448" height="1086" />
              ) : (
                <div class="b1-gallery-ph">Video to be added</div>
              )}
              <figcaption>
                <span class="b1-gallery-step">{v.step}</span>
                <span class="b1-gallery-label">{v.label}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Industrial Applications -->
  <section id="applications" class="b1-section">
    <div class="b1-container">
      <div class="b1-heading">
        <h2>Industrial Applications</h2>
        <p>Components manufactured for demanding drive systems across heavy industry.</p>
      </div>
      <div class="b1-apps">
        {industries.map((i) => (
          <div class="b1-app">
            <div class="b1-app-body">
              <h3>{i.label}</h3>
              <p>{i.desc}</p>
              <a href={i.href}>See related products →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Quality & Inspection -->
  <section id="quality" class="b1-section b1-section-gray">
    <div class="b1-container">
      <div class="b1-heading">
        <h2>Manufacturing Quality You Can Verify</h2>
        <p>Inspection and certification evidence behind the finished components.</p>
      </div>
      <div class="b1-quality-grid">
        <div>
          <ul class="b1-quality-list">
            <li>
              <strong>ISO 9001:2015</strong> — certified quality management for gear machining and heat treatment
              (cert. no. 02925Q3DR48R3S).
            </li>
            <li>
              <strong>ABS heat-treatment approval</strong> — marine component heat treatment under ABS approval
              HT-0579098.
            </li>
            <li>
              <strong>Gear measurement</strong> — Gleason 1000GMS gear analyzer with three CMMs for dimensional
              verification.
            </li>
            <li>
              <strong>NDT &amp; materials testing</strong> — qualified ultrasonic and magnetic-particle inspectors,
              hardness and metallographic analysis.
            </li>
          </ul>
          <div class="b1-quality-actions">
            <a class="b1-btn b1-btn-primary" href="/en/certificates">View Certificates</a>
            <a class="b1-btn b1-btn-ghost" href="/en/equipment/inspection">Inspection Equipment →</a>
          </div>
        </div>
        <div class="b1-cert-cards">
          {certs.map((c) => (
            <a class="b1-cert-card" href="/en/certificates">
              <img src={c.img} alt={c.alt} loading="lazy" width="400" height="284" />
              <span>{c.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Contact -->
  <CTA lang={lang} />

  <script>
    const track = document.getElementById('b1-gallery-track');
    const prev = document.getElementById('b1-gallery-prev');
    const next = document.getElementById('b1-gallery-next');
    if (track && prev && next) {
      const step = () => {
        const tile = track.querySelector('.b1-gallery-tile');
        return tile ? tile.offsetWidth + 14 : track.clientWidth * 0.8;
      };
      const update = () => {
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
      };
      prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }
  </script>
</Base>

<style>
  .b1-container { max-width: 1280px; margin-inline: auto; padding-inline: 24px; }

  .b1-section { padding-block: 88px; }
  .b1-section-gray { background: #f5f6f8; }
  @media (max-width: 767px) {
    .b1-section { padding-block: 56px; }
  }

  .b1-heading { max-width: 760px; }
  .b1-heading h2 { font-family: var(--font-display); font-size: clamp(28px, 3.2vw, 38px); font-weight: 700; color: #0b1a33; letter-spacing: -0.02em; line-height: 1.2; }
  .b1-heading p { margin-top: 14px; font-size: 17px; line-height: 1.75; color: #475569; }

  .b1-btn { display: inline-block; padding: 14px 26px; border-radius: 4px; font-size: 15px; font-weight: 600; transition: background-color .15s ease, color .15s ease, border-color .15s ease; }
  .b1-btn-primary { background: #215694; color: #fff; }
  .b1-btn-primary:hover { background: #1b4577; }
  .b1-btn-ghost { border: 1px solid #c0d4ec; color: #215694; }
  .b1-btn-ghost:hover { border-color: #215694; background: #eef4fb; }

  /* Hero */
  .b1-hero { background: linear-gradient(160deg, #edf3fb 0%, #ddeaf8 45%, #c8ddf2 100%); border-bottom: 1px solid #b7cfe8; }
  .b1-hero-grid { max-width: 1280px; margin-inline: auto; padding: 72px 24px 48px; display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 48px; align-items: center; }
  .b1-eyebrow { font-size: 12px; font-weight: 600; letter-spacing: .14em; color: #1b4577; text-transform: uppercase; }
  .b1-hero-copy h1 { margin-top: 18px; font-family: var(--font-display); font-size: clamp(34px, 4vw, 52px); font-weight: 700; line-height: 1.12; letter-spacing: -0.025em; color: #0b1a33; text-wrap: balance; }
  .b1-hero-intro { margin-top: 20px; font-size: 17px; line-height: 1.7; color: #33425c; max-width: 540px; }
  .b1-hero-intro-2 { margin-top: 12px; font-weight: 500; color: #0b1a33; }
  .b1-hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; align-items: center; }
  .b1-hero .b1-btn-ghost { background: rgba(255, 255, 255, .75); }
  .b1-hero-envelope { margin-top: 24px; padding-top: 16px; border-top: 1px solid rgba(33, 86, 148, .22); font-size: 14px; color: #3d4d68; max-width: 540px; }
  .b1-hero-envelope span { display: block; margin-bottom: 6px; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #1b4577; }
  .b1-hero-fig { margin: 0; background: #fff; border-radius: 6px; overflow: hidden; box-shadow: 0 18px 44px rgba(11, 26, 51, .14); }
  .b1-hero-fig img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .b1-hero-fig figcaption { padding: 14px 18px; background: #fff; border-top: 1px solid #e8edf4; font-size: 13px; color: #64748b; }
  @media (max-width: 900px) {
    .b1-hero-grid { grid-template-columns: 1fr; padding-top: 48px; gap: 32px; }
    .b1-hero-fig { order: 2; }
  }

  /* Facts strip */
  .b1-facts { max-width: 1280px; margin-inline: auto; padding: 0 24px 40px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .b1-fact { border-top: 1px solid rgba(33, 86, 148, .22); padding-top: 16px; }
  .b1-fact strong { display: block; font-family: var(--font-display); font-size: 18px; font-weight: 700; color: #0b1a33; }
  .b1-fact span { display: block; margin-top: 4px; font-size: 13px; color: #55688a; }
  @media (max-width: 767px) {
    .b1-facts { grid-template-columns: repeat(2, 1fr); gap: 20px 16px; }
  }

  /* Product families */
  .b1-families { margin-top: 44px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .b1-family { display: block; background: #fff; border: 1px solid #e8edf4; border-radius: 6px; overflow: hidden; text-decoration: none; transition: box-shadow .15s ease, border-color .15s ease; }
  .b1-family:hover { border-color: #c0d4ec; box-shadow: 0 10px 28px rgba(11, 26, 51, .08); }
  .b1-family-img img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; background: #eef2f7; }
  .b1-family-body { padding: 18px 18px 20px; }
  .b1-family-body h3 { font-family: var(--font-display); font-size: 17px; font-weight: 700; color: #0b1a33; }
  .b1-family-body p { margin-top: 8px; font-size: 13.5px; line-height: 1.6; color: #64748b; }
  .b1-family-link { display: inline-block; margin-top: 12px; font-size: 13.5px; font-weight: 600; color: #215694; }
  @media (max-width: 1100px) {
    .b1-families { grid-template-columns: repeat(2, 1fr); gap: 24px; }
  }
  @media (max-width: 767px) {
    .b1-families { grid-template-columns: 1fr; gap: 16px; }
  }

  /* Process */
  .b1-process { margin-top: 48px; list-style: none; display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
  .b1-process li { position: relative; }
  .b1-process li:not(:last-child)::after { content: '→'; position: absolute; top: 42%; right: -15px; transform: translateY(-50%); color: #8fb2dc; font-size: 18px; z-index: 1; }
  .b1-process-card { display: flex; flex-direction: column; height: 100%; background: #fff; border: 1px solid #e8edf4; border-radius: 6px; overflow: hidden; text-decoration: none; transition: border-color .15s ease, box-shadow .15s ease; }
  .b1-process-card:hover { border-color: #8fb2dc; box-shadow: 0 10px 24px rgba(11, 26, 51, .08); }
  .b1-process-media { display: block; }
  .b1-process-media img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .b1-process-ph { display: grid; place-items: center; aspect-ratio: 4 / 3; background: #eef2f7; border-bottom: 1px dashed #c0d4ec; color: #94a3b8; font-size: 13px; }
  .b1-process-num { display: block; padding: 14px 16px 0; font-family: var(--font-display); font-size: 12px; font-weight: 700; letter-spacing: .08em; color: #8fb2dc; }
  .b1-process-label { display: block; padding: 6px 16px 0; font-family: var(--font-display); font-size: 16px; font-weight: 700; color: #0b1a33; }
  .b1-process-hint { display: block; padding: 2px 16px 0; font-size: 12.5px; color: #64748b; }
  .b1-process-cap { display: block; padding: 8px 16px 0; font-size: 13px; line-height: 1.55; color: #334155; }
  .b1-process-cta { display: block; margin-top: auto; padding: 12px 16px 14px; font-size: 13px; font-weight: 600; color: #215694; }
  .b1-process-note { margin-top: 22px; font-size: 14px; color: #64748b; }
  @media (max-width: 1100px) {
    .b1-process { grid-template-columns: repeat(3, 1fr); }
    .b1-process li:not(:last-child)::after { content: none; }
  }
  @media (max-width: 640px) {
    .b1-process { grid-template-columns: 1fr; }
  }

  /* Equipment strip */
  .b1-equip-head { margin-top: 48px; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 10px; }
