  { m: 'NILES ZE1200', r: 'M25 × Φ1200（外齿）/ Φ1080（内齿）', i: '德国 NILES 内外齿磨齿设备，覆盖直径 1200 mm 以内齿轮批量精磨。' },
  { m: 'Ri1250（德国霍夫曼）', r: 'M25 × Φ1200（外齿）', i: '德国霍夫曼高效成形磨齿机，适合大模数重载齿轮。' },
