];

const cmms = [
  { m: '三坐标测量仪 Hexagon 15.22.10', r: '1500 × 2200 × 1000', i: '海克斯康三坐标测量仪，检测平行度、同轴度、圆度等形位公差及齿部精度。' },
  { m: '三坐标测量仪 DEA Delta20.33.15', r: '3300 × 2000 × 1500', i: '意大利 DEA 三坐标测量仪，适合大型零件形位公差检测。' },
  { m: '三坐标测量仪 VENUS20.33.14', r: '3300 × 2000 × 1400', i: '上海灿栎 VENUS 三坐标测量仪，大行程精密测量。' },
];

const ndt = [
  '超声波探伤仪 OMNISX（奥林巴斯）/ USM36S（GE）',
  '磁粉探伤机 CJW-10000（齿面探伤）',
  '直读式光谱仪 DE-2000（检测 28 个合金元素）',
  '齿面烧伤检测线（酸洗检测）',
  '剩磁仪 HT20A / 粗糙度仪 三丰 178-560 ×4',
];

const hardnessMetallography = [
  '里氏硬度计 9 台 / 布氏硬度计 4 台 / 洛氏硬度计 4 台',
  '维氏硬度计 2 台 / 显微硬度计 HV-1000AT 2 台',
