    rows: [
      { m: '龙门加工中心 SK-LMX2030', r: '3000 × 2000 × 1000', i: '南京高传四开大型龙门加工中心，适合大型结构件铣削。' },
      { m: '加工中心 SK-VM1580', r: '1500 × 800 × 800', i: '南京高传四开立式加工中心，用于通用精密铣削。' },
      { m: '加工中心 HCMC-1370', r: '1300 × 700 × 660', i: '协鸿工业四轴加工中心，一次装夹完成多面加工。' },
