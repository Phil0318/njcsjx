---
interface Row {
  m: string;
  r?: string;
  n?: string;
  i: string;
  img?: string;
  group?: boolean;
  anchor?: string;
}

interface Props {
  title?: string;
  note?: string;
  head: string[];
  rows: Row[];
  variant?: 'light' | 'dark';
  id?: string;
  photoHead?: string;
}

const { title, note, head, rows, variant = 'light', id, photoHead } = Astro.props;
const dark = variant === 'dark';
const hasPhotos = rows.some((r) => r.img);
const colCount = head.length + (hasPhotos ? 1 : 0);
---

<div id={id} class="scroll-mt-24">
  {title && (
    <h2 class:list={['font-display text-2xl font-bold sm:text-3xl', dark ? 'text-white' : 'text-ink']}>
      {title}
    </h2>
  )}
  {note && <p class:list={['mt-2', dark ? 'text-slate-400' : 'text-slate-600']}>{note}</p>}
  <div class:list={[
    'mt-6 overflow-x-auto rounded-lg shadow-sm',
    dark ? 'ring-1 ring-white/10' : 'border border-slate-100',
  ]}>
    <table class="w-full min-w-[560px] table-fixed text-left text-sm">
      <thead class:list={dark ? 'bg-white/10 text-white' : 'bg-steel-700 text-white'}>
        <tr>
          <th scope="col" class:list={['px-5 py-3.5 font-semibold', hasPhotos ? 'w-2/5' : 'w-1/2']}>{head[0]}</th>
          {head[1] && <th scope="col" class="px-5 py-3.5 font-semibold">{head[1]}</th>}
          {head[2] && <th scope="col" class="w-48 px-5 py-3.5 font-semibold">{head[2]}</th>}
          {hasPhotos && (
            <th scope="col" class="w-28 px-5 py-3.5 text-center font-semibold">{photoHead ?? 'Photo'}</th>
          )}
        </tr>
      </thead>
      <tbody class:list={dark ? 'divide-y divide-white/10' : 'divide-y divide-slate-100 bg-white'}>
        {rows.map((row) =>
          row.group ? (
            <tr id={row.anchor} class:list={['scroll-mt-24', dark ? 'bg-white/10' : 'bg-steel-100/70']}>
              <td
                colspan={colCount}
                class:list={[
                  'px-5 py-2.5 font-display text-xs font-bold uppercase tracking-widest',
                  dark ? 'text-accent-400' : 'text-steel-700',
                ]}
              >
                {row.m}
              </td>
            </tr>
          ) : (
            <tr
              class:list={[
                'transition-colors',
                dark ? 'hover:bg-white/5' : 'hover:bg-steel-50',
              ]}
              data-model={row.m}
              data-intro={row.i}
            >
              <td class:list={[
                'px-5 py-3 font-medium',
                hasPhotos ? 'w-2/5' : 'w-1/2',
                dark ? 'text-slate-200' : 'text-ink',
              ]}>
                <details><summary class="cursor-pointer font-semibold">{row.m}</summary><p class="mt-2 text-sm font-normal leading-relaxed">{row.i}</p></details>
              </td>
              <td class:list={['px-5 py-3', dark ? 'text-slate-400' : 'text-slate-600']}>{row.r}</td>
              {head[2] && (
                <td class:list={['px-5 py-3', dark ? 'text-slate-400' : 'text-slate-600']}>{row.n}</td>
              )}
              {hasPhotos && (
                <td class="px-5 py-2 text-center">
                  {row.img ? (
                    <img
                      src={row.img}
                      alt={row.m}
                      loading="lazy"
                      class="mx-auto h-14 w-24 rounded-lg object-cover ring-1 ring-slate-200"
                      onerror="this.style.display='none'"
                    />
                  ) : (
                    <div class:list={[
                      'mx-auto grid h-14 w-24 place-items-center rounded-lg',
                      dark ? 'bg-white/5 ring-1 ring-white/10' : 'bg-steel-50 ring-1 ring-slate-200',
                    ]}>
                      <svg class:list={['h-5 w-5', dark ? 'text-white/20' : 'text-steel-300']} fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A1.5 1.5 0 0021.75 19.5V4.5A1.5 1.5 0 0020.25 3H3.75A1.5 1.5 0 002.25 4.5v15A1.5 1.5 0 003.75 21zM10.5 8.25h.008v.008H10.5V8.25z"></path>
                      </svg>
                    </div>
                  )}
                </td>
              )}
            </tr>
          )
        )}
      </tbody>
    </table>
  </div>
</div>
