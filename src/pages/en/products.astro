---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { productFamilies } from '../../data/product-families';

const lang = 'en' as const;
const families = productFamilies.en;
---

<Base
  lang={lang}
  title="Products — Industrial Gears & Shafts | Changsheng Machinery"
  description="Gears and ring gears, pinions and gear shafts, planetary and compound gears, and custom shafts manufactured to drawing in Nanjing, China."
>
  <section class="page-heading bg-ink">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-12 sm:pt-24 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent-400">Products</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">Gears &amp; shafts manufactured to your drawing.</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-300">
        Representative components machined, heat-treated, ground, and inspected at the Changsheng Nanjing facility.
        Every part below was produced to customer drawings.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid gap-6 md:grid-cols-2">
        {families.map((f) => (
          <a
            href={`/${lang}/products/${f.id}`}
            class="group overflow-hidden rounded-lg border border-slate-100 bg-white shadow-sm transition-all hover:border-steel-300 hover:shadow-md"
          >
            <div class="aspect-[4/3] overflow-hidden bg-steel-100">
              <img
                src={`/products/${f.photos[0].file}`}
                alt={`${f.photos[0].caption} manufactured by Changsheng`}
                loading="lazy"
                width="1448"
                height="1086"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
              />
            </div>
            <div class="p-6">
              <h2 class="font-display text-xl font-bold text-ink">{f.name}</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{f.desc}</p>
              <p class="mt-4 flex items-center justify-between text-sm font-semibold text-steel-700">
                <span>{f.photos.length} photos · View family →</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Heat treatment remains a separate service under Services & Equipment -->

  <CTA lang={lang} />
</Base>
