---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';

const lang = 'en' as const;

const divisions = [
  {
    href: `/${lang}/equipment/machining`,
    num: '01',
    title: 'Machining Equipment',
    blurb: 'German NILES grinder fleet, Doosan lathes, CNC vertical lathes and gear cutting machines — the complete gear process.',
    stats: [['Gear grinding', 'M50 × Ø3000'], ['Machine tools', '50+'], ['Gear milling', 'M50 × Ø5000']],
  },
  {
    href: `/${lang}/equipment/heat-treatment`,
    num: '02',
    title: 'Heat Treatment & Processes',
    blurb: 'Aichelin/Tianlong pit carburizers, vacuum gas quench, sealed-quench lines and cryogenic chamber — ~50,000 t/year.',
    stats: [['Largest carburizer', 'Ø4000 × 2000'], ['Part capacity', '0.1 kg – 30 t'], ['Qualification', 'ABS approved']],
  },
  {
    href: `/${lang}/equipment/inspection`,
    num: '03',
    title: 'Inspection & Metrology',
    blurb: 'Gleason gear analyzer, CMMs, NDT and metallurgical laboratories — full-process quality control.',
    stats: [['Gear measurement', 'Gleason 1000GMS'], ['CMMs', '3 (up to 3.3 m travel)'], ['Metallography', 'Zeiss XJG-04']],
  },
];
---

<Base
  lang={lang}
  title="Services & Equipment — Nanjing Changsheng Machinery Engineering Co., Ltd."
  description="Changsheng Group's three divisions: machining (NILES gear grinders up to M50 × Ø3000), heat treatment (Aichelin/Tianlong pit carburizers, ABS-approved), and inspection & metrology (Gleason gear analyzer, CMMs)."
>
  <section class="page-heading bg-ink">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-14 sm:pt-24 sm:pb-20 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent-400">Services & Equipment</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">Three service divisions, one complete chain.</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-300">
        From blank to finished gear — machining, heat treatment and inspection work hand in hand.
        50+ machine tools, 100+ heat-treatment units and a professional metrology lab.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid gap-6 lg:grid-cols-3">
        {divisions.map((d) => (
          <a
            href={d.href}
            class="group flex flex-col rounded-lg border border-slate-100 bg-white p-8 shadow-sm transition-shadow hover:shadow-md"
          >
            <div class="flex items-center justify-between">
              <span class="font-display text-4xl font-bold text-steel-200 transition-colors group-hover:text-accent-500">
                {d.num}
              </span>
              <svg
                class="h-6 w-6 text-steel-300 transition-transform group-hover:translate-x-1 group-hover:text-accent-500"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12l-7.5 7.5M21 12H3"></path>
              </svg>
            </div>
            <h2 class="mt-6 font-display text-2xl font-bold text-ink">{d.title}</h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{d.blurb}</p>
            <dl class="mt-6 space-y-2.5 border-t border-slate-100 pt-5">
              {d.stats.map(([k, v]) => (
                <div class="flex items-baseline justify-between gap-3 text-sm">
                  <dt class="text-slate-500">{k}</dt>
                  <dd class="font-semibold text-ink">{v}</dd>
                </div>
              ))}
            </dl>
          </a>
        ))}
      </div>

      <div class="mt-12 rounded-lg bg-ink p-8 sm:p-10">
        <div class="grid gap-6 sm:grid-cols-3">
          {[
            ['6 NILES gear grinders', 'Up to module 50 × Ø3000 mm'],
            ['ABS approval', 'Marine heat-treatment facility & process'],
            ['Gleason gear analysis', 'Modules 1–56 full inspection'],
          ].map(([title, desc]) => (
            <div>
              <p class="font-display text-lg font-bold text-white">{title}</p>
              <p class="mt-1.5 text-sm text-slate-400">{desc}</p>
            </div>
          ))}
        </div>
        <a
          href={`/${lang}/products`}
          class="mt-8 inline-block rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-accent-400 hover:text-accent-400"
        >
          View products →
        </a>
      </div>
    </div>
  </section>

  <CTA lang={lang} />
</Base>
