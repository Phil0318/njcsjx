---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';

const lang = 'en' as const;

const certs = [
  {
    title: 'ISO 9001:2015 Quality Management System',
    body: 'Subsidiary Nanjing Zhengsheng Machinery Manufacturing Co., Ltd. is certified to ISO 9001:2015 (certificate no. 02925Q3DR48R3S), covering the full gear-machining and heat-treatment quality chain.',
    images: ['/certificates/iso-9001-1.jpg', '/certificates/iso-9001-2.jpg'],
  },
  {
    title: 'ABS Heat Treatment Facility & Process Approval',
    body: 'Nanjing Dousheng Metal Heat-Treatment Co., Ltd. holds American Bureau of Shipping (ABS) facility & process approval (certificate no. HT-0579098) — quenching & tempering, carburizing — for marine components such as climbing pinions and output gearing, valid until January 2031.',
    images: [
      '/certificates/abs-ht-0579098-1.jpg',
      '/certificates/abs-ht-0579098-2.jpg',
      '/certificates/abs-ht-0579098-3.jpg',
    ],
  },
  {
    title: 'NDT Personnel Qualification Certificates',
    body: 'Certified NDT inspectors (ultrasonic & magnetic particle testing) ensure authoritative inspection of forgings and gear tooth flanks.',
    images: [
      '/certificates/ndt-cert-1.jpg',
      '/certificates/ndt-cert-2.jpg',
      '/certificates/ndt-cert-3.jpg',
      '/certificates/ndt-cert-4.jpg',
      '/certificates/ndt-cert-5.jpg',
    ],
  },
];
---

<Base
  lang={lang}
  title="Certifications — Nanjing Changsheng Machinery Engineering Co., Ltd."
  description="Changsheng Group certifications: ISO 9001:2015 (02925Q3DR48R3S), ABS heat-treatment facility approval (HT-0579098, valid to 2031), and NDT personnel qualification certificates."
>
  <section class="page-heading bg-ink">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-12 sm:pt-24 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent-400">Certifications</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">Certifications & qualifications.</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-300">
        ISO 9001 quality management, ABS heat-treatment facility approval and certified NDT
        personnel — dependable quality assurance for our customers.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl space-y-16 px-4 sm:px-6">
      {certs.map((c) => (
        <div>
          <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">{c.title}</h2>
          <p class="mt-3 max-w-3xl leading-relaxed text-slate-600">{c.body}</p>
          <div class:list={['mt-6 grid gap-6', c.images.length > 1 && 'sm:grid-cols-2']}>
            {c.images.map((img) => (
              <a
                href={img}
                target="_blank"
                rel="noopener"
                class="overflow-hidden rounded-lg border border-slate-100 bg-white p-3 shadow-sm transition-shadow hover:shadow-lg"
              >
                <img
                  src={img}
                  alt={c.title}
                  loading="lazy"
                  class="mx-auto h-auto w-full rounded-xl object-contain ring-1 ring-slate-100"
                />
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <CTA lang={lang} />
</Base>
