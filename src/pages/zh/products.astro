---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';

const lang = 'zh' as const;

const products = [
  {
    title: '泥浆泵齿轮 / 齿轮轴',
    desc: '海上钻井平台泥浆泵核心传动零件，承受高载荷与恶劣工况，经渗碳淬火与精密磨齿。',
    process: '工艺：渗碳淬火 · 磨齿',
  },
  {
    title: '风电变桨齿轮轴',
    desc: '风力发电机组变桨系统关键部件，对疲劳寿命与可靠性要求极高。',
    process: '工艺：渗碳淬火 · 磨齿 · 探伤',
  },
  {
    title: '钻井平台爬升装置零件 / 爬升齿轮轴',
    desc: '海洋钻井平台爬升系统大型齿轮轴与结构件。',
    process: '工艺：调质 · 渗碳淬火 · 磨齿（ABS 认可）',
  },
  {
    title: '矿用车辆电动轮双联齿轮',
    desc: '矿用自卸车电动轮驱动系统双联齿轮。',
    process: '工艺：滚齿 · 渗碳淬火 · 磨齿',
  },
  {
    title: '建材空心轴',
    desc: '建材行业大型装备用空心轴类零件。',
    process: '工艺：车削 · 调质 · 精磨',
  },
  {
    title: '定制零件热处理',
    desc: '各类黑色、有色金属及特殊材料零件的正火、退火、调质、渗碳、氮化、感应淬火等。',
    process: '工艺：真空油淬 · 气淬 · 氮化 · 感应淬火',
  },
];
---

<Base
  lang={lang}
  title="产品展示 — 南京长升机械工程有限公司"
  description="长升机械产品：泥浆泵齿轮与齿轮轴、风电变桨齿轮轴、钻井平台爬升装置零件、矿用电动轮双联齿轮、建材空心轴及各类零件热处理。"
>
  <section class="page-heading bg-ink">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-12 sm:pt-24 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent-400">产品展示</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">重工业关键零部件。</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-300">
        服务海洋钻井平台、风电、矿用、石化、冶金与建材行业的核心传动零件。
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => (
          <div class="group overflow-hidden rounded-lg border border-slate-100 bg-white shadow-sm transition-all hover:border-steel-300 hover:shadow-md">
            <div class="p-6 border-t-2 border-steel-600">
              <h2 class="font-display text-lg font-bold text-ink">{p.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{p.desc}</p>
              <p class="mt-3 inline-block rounded-md bg-steel-50 px-2.5 py-1 text-xs font-medium text-steel-600">{p.process}</p>
              <a href={`/${lang}/contact`} class="mt-6 block text-sm font-semibold text-steel-700 hover:underline">咨询该产品 →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA lang={lang} />
</Base>
