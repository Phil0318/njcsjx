---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { productFamilies } from '../../data/product-families';

const lang = 'zh' as const;
const families = productFamilies.zh;
---

<Base
  lang={lang}
  title="产品展示 — 工业齿轮与轴类 | 南京长升机械工程有限公司"
  description="按图纸制造的齿轮与齿圈、小齿轮与齿轮轴、行星与双联齿轮及定制轴类零件，工厂位于江苏南京。"
>
  <section class="page-heading bg-ink">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-12 sm:pt-24 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent-400">产品展示</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">按图纸制造的齿轮与轴类零件。</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-300">
        以下零件均由南京长升在工厂内完成加工、热处理、磨削与检验，全部按客户图纸生产。
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid gap-6 md:grid-cols-2">
        {families.map((f) => (
          <a
            href={`/${lang}/products/${f.id}`}
            class="group overflow-hidden rounded-lg border border-slate-100 bg-white shadow-sm transition-all hover:border-steel-300 hover:shadow-md"
          >
            <div class="aspect-[4/3] overflow-hidden bg-steel-100">
              <img
                src={`/products/${f.photos[0].file}`}
                alt={`${f.photos[0].caption}，南京长升制造`}
                loading="lazy"
                width="1448"
                height="1086"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
              />
            </div>
            <div class="p-6">
              <h2 class="font-display text-xl font-bold text-ink">{f.name}</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{f.desc}</p>
              <p class="mt-4 flex items-center justify-between text-sm font-semibold text-steel-700">
                <span>{f.photos.length} 张照片 · 查看分类 →</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Heat treatment: a service, not a product family -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="rounded-lg border border-steel-200 bg-white p-8 sm:p-10">
        <div class="flex flex-wrap items-start justify-between gap-6">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-wider text-steel-600">服务</p>
            <h2 class="mt-2 font-display text-2xl font-bold text-ink sm:text-3xl">客户来料的热处理服务</h2>
            <p class="mt-3 text-base leading-relaxed text-slate-600">
              正火、退火、调质、渗碳、氮化、感应淬火等——可作为独立服务承接客户来料，
              单件重量 0.1&nbsp;kg 至 30&nbsp;t。
            </p>
          </div>
          <a
            href={`/${lang}/equipment/heat-treatment`}
            class="rounded-full bg-steel-700 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-steel-800"
          >
            热处理服务 →
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTA lang={lang} />
</Base>
