---
interface Props {
  src: string;
  name: string;
  hint?: string;
  class?: string;
}

const { src, name, hint = '照片待补充 · Photo coming soon', class: className } = Astro.props;
---

<div class:list={['relative overflow-hidden rounded-2xl bg-steel-100 ring-1 ring-slate-200', className]}>
  <div class="absolute inset-0 grid place-items-center">
    <div class="text-center">
      <svg class="mx-auto h-10 w-10 text-steel-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A1.5 1.5 0 0021.75 19.5V4.5A1.5 1.5 0 0020.25 3H3.75A1.5 1.5 0 002.25 4.5v15A1.5 1.5 0 003.75 21zM10.5 8.25h.008v.008H10.5V8.25z"></path>
      </svg>
      <p class="mt-2 text-xs font-medium text-steel-400">{name}</p>
      <p class="mt-0.5 text-[10px] text-steel-300">{hint}</p>
    </div>
  </div>
  <img
    src={src}
    alt={name}
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover"
    onerror="this.style.display='none'"
  />
</div>
