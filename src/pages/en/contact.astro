---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import { SITE } from '../../config';

const lang = 'en' as const;
---

<Base
  lang={lang}
  title="Contact — Nanjing Changsheng Machinery Engineering Co., Ltd."
  description="Contact Nanjing Changsheng Machinery Engineering Co., Ltd. for gear machining and heat-treatment quotes. We reply within 1–2 business days."
>
  <section class="bg-ink">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-12 sm:pt-24 text-center">
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">Professional gear & heat-treatment supplier since 2006</h1>
      <a
        href="#quote-form"
        class="mt-8 inline-block rounded-full bg-accent-500 px-8 py-3.5 font-semibold text-white shadow-lg shadow-accent-500/25 transition-transform hover:scale-105"
      >
        Contact Us
      </a>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 grid gap-12 lg:grid-cols-5">
      <div class="lg:col-span-3 rounded-[2rem] border border-slate-100 bg-white p-8 shadow-sm sm:p-10">
        <h2 class="font-display text-xl font-bold text-ink">Request a quote</h2>
        <p class="mt-2 text-sm text-slate-500">Fields marked * are required</p>
        <div class="mt-6">
          <ContactForm lang={lang} />
        </div>
      </div>
      <div class="lg:col-span-2 space-y-6">
        <div class="rounded-[2rem] bg-ink p-8">
          <h2 class="font-display text-xl font-bold text-white">Contact details</h2>
          <div class="mt-5 space-y-4 text-sm">
            <div>
              <p class="text-slate-400">Email</p>
              <a href={`mailto:${SITE.email}`} class="mt-1 inline-block font-semibold text-accent-400 hover:text-accent-500">
                {SITE.email}
              </a>
            </div>
            <div>
              <p class="text-slate-400">Phone</p>
              <p class="mt-1 font-semibold text-white">{SITE.phone}</p>
            </div>
            <div>
              <p class="text-slate-400">Address</p>
              <p class="mt-1 text-white">{SITE.addressEn}</p>
            </div>
          </div>
        </div>
        <div class="rounded-[2rem] border border-slate-100 p-8">
          <h2 class="font-display text-xl font-bold text-ink">How drawing-based orders work</h2>
          <ol class="mt-4 space-y-4">
            {[
              'Send drawings & specifications (PDF / DWG / STEP all accepted)',
              'We evaluate the process and quote (1–2 business days)',
              'Order confirmed — production & heat treatment begin',
              'Parts inspected and shipped on approval',
            ].map((s, i) => (
              <li class="flex items-start gap-3">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-steel-700 font-display text-sm font-bold text-white">
                  {i + 1}
                </span>
                <span class="text-slate-600">{s}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="rounded-[2rem] border border-slate-100 p-8">
          <h2 class="font-display text-xl font-bold text-ink">Working hours</h2>
          <p class="mt-3 text-slate-600">Monday – Saturday, 8:00 – 17:30 (Beijing time)</p>
        </div>
      </div>
    </div>
  </section>
</Base>
